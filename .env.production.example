# Copy to the production host as `.env.production` (never commit real secrets).
# Rebuild AFTER setting these so HTML robots / sitemap / canonicals bake correctly.

PUBLIC_SITE_URL=https://growgreenweedcontrol.com
PUBLIC_SITE_INDEXING=true

GGWC_CRM_MODE=live
GGWC_CRM_BASE_URL=https://crm.growgreenweedcontrol.com
GGWC_CRM_API_KEY=

# Browser-restricted public token (production origins only)
PUBLIC_MAPBOX_TOKEN=

# Meta Pixel base (PageView). Required at build time for production tracking.
PUBLIC_META_PIXEL_ID=1014961828315598

# Google Business Profile reviews — website OAuth client only
GOOGLE_REVIEWS_CLIENT_ID=
GOOGLE_REVIEWS_CLIENT_SECRET=
GOOGLE_REVIEWS_REDIRECT_URI=https://growgreenweedcontrol.com/api/google-reviews/callback
GOOGLE_REVIEWS_DATA_DIR=.data/google-reviews
GOOGLE_REVIEWS_SETUP_ENABLED=false
# GOOGLE_REVIEWS_SETUP_TOKEN=
# GOOGLE_REVIEWS_CRON_SECRET=

HOST=127.0.0.1
PORT=4321
