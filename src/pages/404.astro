---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
import { blogPosts } from "../data/blog-posts.generated";
import { allGeoPageSlugs } from "../lib/geo/resolveGeoPage";
import { campaignBySlug } from "../data/campaigns";
import { relatedServicePages, services } from "../data/services";

/**
 * SSR so unknown mixed-case legacy URLs (e.g. south-Louisiana) can 301 to the
 * canonical lowercase slug instead of soft-404ing. Prerendered 404 cannot see
 * the request path at build time.
 */
export const prerender = false;

const requestPath = Astro.url.pathname;
const trimmed = requestPath.replace(/\/+$/, "") || "/";
const requestSlug = trimmed === "/" ? "" : trimmed.replace(/^\//, "");

const knownSlugs = new Set<string>();
for (const s of services) {
  knownSlugs.add(s.slug);
  s.relatedPages?.forEach((r) => knownSlugs.add(r.slug));
}
Object.keys(relatedServicePages).forEach((s) => knownSlugs.add(s));
allGeoPageSlugs().forEach((s) => knownSlugs.add(s));
Object.keys(campaignBySlug).forEach((s) => knownSlugs.add(s));
blogPosts.forEach((p) => knownSlugs.add(p.slug));
[
  "thank-you",
  "thank-you-nextdoor",
  "thank-you-core-aeration",
  "liquid-aeration-quote-request-received",
  "test",
  "about-us",
  "contact-us",
  "careers",
  "services",
  "privacy-policy",
  "terms-and-conditions",
  "lawn-care-blog",
  "request-a-quote",
  "customer-login-pay-bill",
].forEach((s) => knownSlugs.add(s));

if (requestSlug && !requestSlug.includes("/")) {
  const lower = requestSlug.toLowerCase();
  if (lower !== requestSlug && knownSlugs.has(lower)) {
    return Astro.redirect(`/${lower}/`, 301);
  }
}
---

<BaseLayout
  title="Page not found | Grow Green Weed Control"
  description="The page you requested could not be found."
  noindex
>
  <section class="ty-page">
    <div class="ty-page__inner motion-rise">
      <div class="ty-panel thank-you-panel">
        <p class="ty-panel__eyebrow">Grow Green Weed Control</p>
        <h1>Page not found</h1>
        <p class="ty-panel__lead">
          That URL is not available on this site. Try one of these common destinations—or call the office and we will
          help you get where you need to go.
        </p>
        <ul class="ty-panel__links">
          <li><a href="/">Homepage</a></li>
          <li><a href="/services/">Services</a></li>
          <li><a href="/service-areas/">Service areas</a></li>
          <li><a href="/request-a-quote/">Request a quote</a></li>
          <li><a href="/contact-us/">Contact us</a></li>
        </ul>
        <div class="ty-panel__actions">
          <a class="btn btn-gold" href="/request-a-quote/">Get a free quote</a>
          <a class="btn btn-soft" href={`tel:${site.phoneTel}`}>Call {site.phone}</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
