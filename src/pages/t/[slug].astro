---
import BaseLayout from "../../layouts/BaseLayout.astro";
import QuoteForm from "../../components/QuoteForm.astro";
import { site } from "../../data/site";
import {
  technicians,
  technicianBySlug,
  technicianLeadSource,
  technicianFormSource,
  technicianAttribution,
  technicianReferralNote,
  technicianCanonicalPath,
} from "../../data/technicians";

export const prerender = true;

export function getStaticPaths() {
  return technicians.map((t) => ({ params: { slug: t.slug } }));
}

const slug = Astro.params.slug!;
const tech = technicianBySlug[slug]!;

const leadSource = technicianLeadSource(tech);
const formSource = technicianFormSource(tech);
const attribution = technicianAttribution(tech);
const referralNote = technicianReferralNote(tech);
const canonicalPath = technicianCanonicalPath(tech);
const title = `${tech.name} | ${site.name}`;
const description = `Request a free lawn estimate from Grow Green Weed Control via ${tech.name}, ${tech.role}. ${site.startingPrice.short}`;
const photoPosition = tech.photoPosition || "center 20%";
const photoSrcset = tech.photo.replace(/\.webp$/, "-640.webp");
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  robots="noindex, follow"
  hideChrome
  ogImage={tech.photo}
>
  <section class="tech-lp" aria-label={`${tech.name} estimate landing`}>
    <header class="tech-lp__top">
      <div class="tech-lp__top-inner">
        <a href="/" class="tech-lp__brand" aria-label={`${site.name} home`}>
          <img
            src="/images/brand/logo-128.webp"
            srcset="/images/brand/logo-64.webp 64w, /images/brand/logo-128.webp 128w, /images/brand/logo-192.webp 192w"
            sizes="48px"
            alt=""
            width="48"
            height="48"
            fetchpriority="high"
            decoding="async"
          />
          <span>
            <strong>Grow Green</strong>
            <small>Weed Control</small>
          </span>
        </a>
        <a class="tech-lp__phone" href={`tel:${site.phoneTel}`}>
          <span class="tech-lp__phone-label">Call</span>
          {site.phone}
        </a>
      </div>
    </header>

    <div class="tech-lp__hero">
      <div class="tech-lp__hero-media" aria-hidden="true"></div>
      <div class="tech-lp__hero-veil" aria-hidden="true"></div>
      <div class="tech-lp__hero-inner">
        <p class="tech-lp__brand-mark">Grow Green Weed Control</p>
        <div class="tech-lp__photo-wrap">
          <img
            class="tech-lp__photo"
            src={tech.photo}
            srcset={`${photoSrcset} 640w, ${tech.photo} 960w`}
            sizes="140px"
            alt={tech.photoAlt}
            width="140"
            height="140"
            fetchpriority="high"
            decoding="async"
            style={`object-position: ${photoPosition};`}
          />
        </div>
        <h1>{tech.name}</h1>
        <p class="tech-lp__role">{tech.role}</p>
        <p class="tech-lp__pitch">{tech.pitch}</p>
        <div class="tech-lp__cta">
          <a class="tech-lp__cta-primary" href="#quote">Get a free estimate</a>
          <a class="tech-lp__cta-call" href={`tel:${site.phoneTel}`}>Call {site.phone}</a>
        </div>
      </div>
    </div>

    <div class="tech-lp__trust" aria-label="Why Grow Green">
      <ul>
        {
          site.identity.map((item) => (
            <li>{item}</li>
          ))
        }
      </ul>
    </div>

    <div class="tech-lp__form" id="quote">
      <QuoteForm
        source={formSource}
        leadSource={leadSource}
        heading="Get your free estimate"
        subheading={`Tell us where to treat — ${tech.name} connected you. We’ll prepare pricing and follow up, usually within one business day.`}
        compact
        hideStartingPrice={false}
        extraNotes={referralNote}
        attributionDefaults={attribution}
      />
    </div>

    <footer class="tech-lp__foot">
      <p class="tech-lp__foot-identity">
        Local · Family-owned · Firefighter-owned
      </p>
      <p>
        Office hours: {site.hours.label} ({site.hours.timezone})
      </p>
      <p>
        <a href={`tel:${site.phoneTel}`}>{site.phone}</a>
        <span aria-hidden="true"> · </span>
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </p>
      <p>
        <a href="/privacy-policy/">Privacy</a>
        <span aria-hidden="true"> · </span>
        <a href="/">growgreenweedcontrol.com</a>
      </p>
    </footer>
  </section>
</BaseLayout>

<style>
  .tech-lp {
    min-height: 100vh;
    color: var(--ink);
    background:
      radial-gradient(ellipse 80% 40% at 50% 0%, rgba(47, 139, 58, 0.14), transparent 60%),
      linear-gradient(180deg, #f2f7f3 0%, var(--white) 38%, var(--cream-deep) 100%);
  }

  .tech-lp__top {
    position: sticky;
    top: 0;
    z-index: 5;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }

  .tech-lp__top-inner {
    max-width: 42rem;
    margin: 0 auto;
    padding: 0.7rem 1.15rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .tech-lp__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: inherit;
    text-decoration: none;
  }

  .tech-lp__brand img {
    border-radius: 50%;
    box-shadow: 0 0 0 2px rgba(47, 122, 67, 0.12);
  }

  .tech-lp__brand strong {
    display: block;
    font-size: 1rem;
    line-height: 1.1;
    font-weight: 800;
    color: var(--green-900);
  }

  .tech-lp__brand small {
    display: block;
    margin-top: 0.1rem;
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .tech-lp__phone {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.05rem;
    font-weight: 800;
    font-size: 0.98rem;
    color: var(--green-700);
    text-decoration: none;
    line-height: 1.15;
  }

  .tech-lp__phone-label {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .tech-lp__hero {
    position: relative;
    overflow: hidden;
    color: var(--white);
  }

  .tech-lp__hero-media {
    position: absolute;
    inset: 0;
    background:
      url("/images/home/hero-lawn-1280.webp") center / cover no-repeat;
    transform: scale(1.04);
    animation: tech-lp-ken 18s ease-out both;
  }

  .tech-lp__hero-veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(165deg, rgba(7, 24, 13, 0.92) 0%, rgba(12, 33, 19, 0.78) 48%, rgba(7, 24, 13, 0.88) 100%),
      linear-gradient(180deg, transparent 55%, rgba(7, 24, 13, 0.55));
    pointer-events: none;
  }

  .tech-lp__hero-inner {
    position: relative;
    max-width: 42rem;
    margin: 0 auto;
    padding: 2.1rem 1.15rem 2.4rem;
    text-align: center;
  }

  .tech-lp__brand-mark {
    margin: 0 0 1.1rem;
    font-size: clamp(1.15rem, 3.2vw, 1.45rem);
    font-weight: 800;
    letter-spacing: 0.01em;
    line-height: 1.2;
    color: var(--white);
    animation: tech-lp-rise 0.7s ease-out both;
  }

  .tech-lp__photo-wrap {
    width: 8.75rem;
    height: 8.75rem;
    margin: 0 auto 1rem;
    border-radius: 50%;
    padding: 0.28rem;
    background: linear-gradient(145deg, rgba(245, 162, 10, 0.95), rgba(255, 255, 255, 0.55) 45%, rgba(47, 139, 58, 0.85));
    box-shadow: 0 18px 36px rgba(0, 0, 0, 0.32);
    animation: tech-lp-rise 0.75s ease-out 0.08s both;
  }

  .tech-lp__photo {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    object-position: center 20%;
    display: block;
    border: 2px solid rgba(7, 24, 13, 0.35);
    background: var(--green-800);
  }

  .tech-lp__hero h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 5.5vw, 2.65rem);
    line-height: 1.1;
    font-weight: 800;
    color: var(--white);
    animation: tech-lp-rise 0.75s ease-out 0.14s both;
  }

  .tech-lp__role {
    margin: 0.4rem 0 0;
    font-weight: 700;
    font-size: 1.02rem;
    color: var(--gold-soft);
    animation: tech-lp-rise 0.75s ease-out 0.18s both;
  }

  .tech-lp__pitch {
    margin: 0.95rem auto 0;
    max-width: 28rem;
    color: rgba(255, 255, 255, 0.92);
    font-size: 1.05rem;
    line-height: 1.55;
    animation: tech-lp-rise 0.75s ease-out 0.22s both;
  }

  .tech-lp__cta {
    margin-top: 1.35rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.65rem;
    animation: tech-lp-rise 0.75s ease-out 0.28s both;
  }

  .tech-lp__cta-primary,
  .tech-lp__cta-call {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.85rem;
    padding: 0.65rem 1.2rem;
    border-radius: var(--radius-sm);
    font-weight: 800;
    text-decoration: none;
    transition: transform 0.18s ease, background-color 0.18s ease, border-color 0.18s ease;
  }

  .tech-lp__cta-primary {
    background: var(--gold);
    color: var(--green-950);
    border: 2px solid var(--gold);
  }

  .tech-lp__cta-primary:hover {
    background: var(--gold-hover);
    border-color: var(--gold-hover);
    color: var(--green-950);
    transform: translateY(-1px);
  }

  .tech-lp__cta-call {
    background: transparent;
    color: var(--white);
    border: 2px solid rgba(255, 255, 255, 0.55);
  }

  .tech-lp__cta-call:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.9);
    color: var(--white);
  }

  .tech-lp__trust {
    max-width: 42rem;
    margin: 0 auto;
    padding: 0.85rem 1.15rem 0;
  }

  .tech-lp__trust ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.45rem 0.85rem;
    color: var(--muted);
    font-size: 0.86rem;
    font-weight: 650;
  }

  .tech-lp__trust li {
    position: relative;
    padding-left: 0.95rem;
  }

  .tech-lp__trust li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.45em;
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--green-600);
  }

  .tech-lp__form {
    max-width: 42rem;
    margin: 0.85rem auto 0;
    padding: 0 1.15rem 2rem;
    position: relative;
    z-index: 1;
  }

  .tech-lp__form :global(.quote-panel) {
    border: 1px solid rgba(22, 56, 37, 0.1);
    border-radius: calc(var(--radius) + 2px);
    box-shadow: 0 18px 40px rgba(7, 24, 13, 0.1);
    padding: 1.25rem 1.15rem 1.2rem;
  }

  .tech-lp__foot {
    max-width: 42rem;
    margin: 0 auto;
    padding: 0.25rem 1.15rem 2.75rem;
    text-align: center;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .tech-lp__foot-identity {
    color: var(--green-800);
    font-weight: 700;
  }

  .tech-lp__foot p {
    margin: 0.4rem 0;
  }

  .tech-lp__foot a {
    font-weight: 650;
    color: var(--green-700);
    text-decoration: none;
  }

  .tech-lp__foot a:hover {
    text-decoration: underline;
  }

  @keyframes tech-lp-rise {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes tech-lp-ken {
    from {
      transform: scale(1.08);
    }
    to {
      transform: scale(1.02);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tech-lp__hero-media,
    .tech-lp__brand-mark,
    .tech-lp__photo-wrap,
    .tech-lp__hero h1,
    .tech-lp__role,
    .tech-lp__pitch,
    .tech-lp__cta {
      animation: none;
    }

    .tech-lp__hero-media {
      transform: none;
    }

    .tech-lp__cta-primary,
    .tech-lp__cta-call {
      transition: none;
    }
  }

  @media (min-width: 720px) {
    .tech-lp__hero-inner {
      padding-top: 2.6rem;
      padding-bottom: 2.9rem;
    }

    .tech-lp__photo-wrap {
      width: 10rem;
      height: 10rem;
    }

    .tech-lp__form :global(.quote-panel) {
      padding: 1.45rem 1.4rem 1.35rem;
    }
  }
</style>
