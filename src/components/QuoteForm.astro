---
import { PROMOTIONAL_SMS_DISCLOSURE } from "../lib/leads/promotionalSms";

interface Props {
  source?: string;
  leadSource?: string;
  promotionCode?: string;
  heading?: string;
  subheading?: string;
  compact?: boolean;
}

const {
  source = "website-quote-form",
  leadSource = "Website",
  promotionCode = "",
  heading = "See What Your Lawn Would Cost",
  subheading = "Enter the service address and we’ll prepare an accurate, no-obligation estimate.",
  compact = false,
} = Astro.props;

const mapToken = import.meta.env.PUBLIC_MAPBOX_TOKEN || "";
const addressId = `address-${source}`;
const cityId = `city-${source}`;
const zipId = `zip-${source}`;
const nameId = `name-${source}`;
const emailId = `email-${source}`;
const phoneId = `phone-${source}`;
const notesId = `notes-${source}`;
const smsDisclosure = PROMOTIONAL_SMS_DISCLOSURE;
---

<div
  class:list={["quote-form", compact && "compact"]}
  data-quote-form
  data-source={source}
  data-lead-source={leadSource}
  data-promotion={promotionCode}
  data-mapbox={mapToken}
  data-sms-disclosure={smsDisclosure}
>
  <div class="form-panel quote-panel">
    <p class="step-label" data-step-label>Step 1 of 2 — Property details</p>
    <h2>{heading}</h2>
    <p class="form-lead">{subheading}</p>
    <p class="price-start">
      Plans start at <strong>$39/month</strong>. Your estimate depends on lawn size and selected services.
    </p>

    <form data-quote-el novalidate>
      <div class="hp" aria-hidden="true">
        <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
      </div>

      <div data-step="1">
        <div class="field">
          <label for={addressId}>Service address</label>
          <input
            id={addressId}
            name="address"
            autocomplete="street-address"
            placeholder="Start typing your street address"
            required
          />
          <small>Choose a suggestion or enter the address manually.</small>
          <div class="suggest" data-suggest hidden role="listbox" aria-label="Address suggestions"></div>
        </div>
        <div class="field-row two">
          <div class="field">
            <label for={cityId}>City</label>
            <input id={cityId} name="city" autocomplete="address-level2" required />
          </div>
          <div class="field">
            <label for={zipId}>ZIP code</label>
            <input id={zipId} name="zip" autocomplete="postal-code" inputmode="numeric" required />
          </div>
        </div>
        <input type="hidden" name="state" value="LA" />
        <button class="btn btn-gold btn-block" type="button" data-next>Continue →</button>
      </div>

      <div data-step="2" hidden>
        <div class="field">
          <label for={nameId}>Full name</label>
          <input id={nameId} name="name" autocomplete="name" required />
        </div>
        <div class="field-row two">
          <div class="field">
            <label for={emailId}>Email</label>
            <input id={emailId} name="email" type="email" autocomplete="email" required />
          </div>
          <div class="field">
            <label for={phoneId}>Phone</label>
            <input id={phoneId} name="phone" type="tel" autocomplete="tel" required />
          </div>
        </div>
        <div class="field">
          <label for={notesId}>Anything we should know? (optional)</label>
          <textarea id={notesId} name="notes" rows="3"></textarea>
        </div>
        <div class="field checkbox">
          <label class="consent-label">
            <input type="checkbox" name="sms_opt_in" value="Yes" />
            <span>{smsDisclosure}</span>
          </label>
        </div>
        <div class="actions">
          <button class="btn btn-outline-dark" type="button" data-back>Back</button>
          <button class="btn btn-gold btn-grow" type="submit" data-submit>Request My Free Estimate</button>
        </div>
      </div>

      <div class="form-status" data-status hidden role="status" aria-live="polite"></div>
    </form>
  </div>
</div>

<style>
  /* Scoped foreground system — defeats any parent hero/section color inheritance */
  .quote-form {
    width: 100%;
    color: var(--ink);
  }
  .quote-panel {
    color: var(--ink);
    background: #fff;
  }
  .quote-form :is(h2, h3) {
    color: var(--green-950);
  }
  .quote-form :is(p, label, small, span, strong, li) {
    color: inherit;
  }
  .step-label {
    color: var(--green-600) !important;
    font-weight: 900;
    font-size: 0.78rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    margin: 0 0 0.35rem;
  }
  .form-lead {
    color: var(--muted) !important;
    margin-bottom: 0.75rem;
  }
  .price-start {
    background: #f7faf7;
    border-left: 4px solid var(--gold);
    padding: 0.7rem 0.85rem;
    border-radius: 8px;
    margin-bottom: 1rem;
    color: var(--ink) !important;
    font-size: 0.95rem;
  }
  .price-start strong {
    color: var(--ink) !important;
    font-weight: 900;
  }
  .field label {
    color: var(--green-950) !important;
  }
  .field small {
    color: var(--muted) !important;
  }
  .field input,
  .field textarea {
    color: var(--ink) !important;
    background: #fcfdfb !important;
  }
  .field input::placeholder,
  .field textarea::placeholder {
    color: #66756c !important;
    opacity: 1;
  }
  .suggest {
    margin-top: 0.35rem;
    border: 1px solid #c5d3ca;
    border-radius: 10px;
    overflow: hidden;
    background: #fff;
  }
  .suggest button {
    display: block;
    width: 100%;
    text-align: left;
    border: 0;
    background: #fff;
    color: var(--ink);
    padding: 0.65rem 0.8rem;
    cursor: pointer;
    font: inherit;
  }
  .suggest button:hover,
  .suggest button:focus {
    background: var(--green-50);
    outline: none;
  }
  .suggest button:focus-visible {
    outline: 3px solid rgba(47, 122, 74, 0.35);
    outline-offset: -3px;
  }
  .checkbox .consent-label {
    display: flex;
    gap: 0.55rem;
    align-items: flex-start;
    font-weight: 500;
    font-size: 0.9rem;
    color: var(--ink) !important;
  }
  .checkbox .consent-label span {
    color: var(--ink) !important;
  }
  .btn-block {
    width: 100%;
  }
  .actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    align-items: stretch;
  }
  .btn-grow {
    flex: 1 1 12rem;
  }
  @media (max-width: 560px) {
    .actions {
      flex-direction: column;
    }
    .actions .btn {
      width: 100%;
    }
  }
  .btn-outline-dark {
    background: transparent;
    border: 2px solid var(--green-800);
    color: var(--green-800) !important;
    border-radius: var(--radius-sm);
    min-height: 46px;
  }
  .btn-outline-dark:hover {
    background: var(--green-50);
  }
  .compact .quote-panel {
    padding: 1.05rem;
  }
</style>

<script>
  function uuid() {
    if (crypto.randomUUID) return crypto.randomUUID();
    return `ggwc-${Date.now()}-${Math.random().toString(16).slice(2)}`;
  }

  function cookieGet(name) {
    const match = document.cookie.match(
      new RegExp("(?:^|; )" + name.replace(/[.*+?^${}()|[\]\\]/g, "\\$&") + "=([^;]*)"),
    );
    return match ? decodeURIComponent(match[1]) : "";
  }

  function params() {
    const q = new URLSearchParams(location.search);
    return {
      utm_source: q.get("utm_source") || "",
      utm_medium: q.get("utm_medium") || "",
      utm_campaign: q.get("utm_campaign") || "",
      utm_term: q.get("utm_term") || "",
      utm_content: q.get("utm_content") || "",
      fbclid: q.get("fbclid") || "",
      gclid: q.get("gclid") || "",
      fbp: cookieGet("_fbp") || "",
      fbc: cookieGet("_fbc") || "",
    };
  }

  document.querySelectorAll("[data-quote-form]").forEach((root) => {
    if (!(root instanceof HTMLElement)) return;
    if (root.dataset.bound === "1") return;
    root.dataset.bound = "1";

    const form = root.querySelector("[data-quote-el]");
    const step1 = root.querySelector('[data-step="1"]');
    const step2 = root.querySelector('[data-step="2"]');
    const status = root.querySelector("[data-status]");
    const stepLabel = root.querySelector("[data-step-label]");
    const suggest = root.querySelector("[data-suggest]");
    const addressInput = root.querySelector('input[name="address"]');
    const cityInput = root.querySelector('input[name="city"]');
    const zipInput = root.querySelector('input[name="zip"]');
    const nextBtn = root.querySelector("[data-next]");
    const backBtn = root.querySelector("[data-back]");
    const submitBtn = root.querySelector("[data-submit]");
    const mapToken = root.dataset.mapbox || "";
    let idempotencyKey = uuid();
    let submitting = false;
    let conversionFired = false;
    let suggestTimer;

    function showStatus(type, message) {
      if (!(status instanceof HTMLElement)) return;
      status.hidden = false;
      status.className = `form-status ${type}`;
      status.textContent = message;
    }

    function goStep(n) {
      if (!(step1 instanceof HTMLElement) || !(step2 instanceof HTMLElement)) return;
      step1.hidden = n !== 1;
      step2.hidden = n !== 2;
      if (stepLabel) {
        stepLabel.textContent =
          n === 1 ? "Step 1 of 2 — Property details" : "Step 2 of 2 — Contact details";
      }
      const focusEl = n === 2 ? root.querySelector('input[name="name"]') : addressInput;
      if (focusEl instanceof HTMLElement) focusEl.focus();
    }

    nextBtn?.addEventListener("click", () => {
      const address = addressInput instanceof HTMLInputElement ? addressInput.value.trim() : "";
      const city = cityInput instanceof HTMLInputElement ? cityInput.value.trim() : "";
      const zip = zipInput instanceof HTMLInputElement ? zipInput.value.trim() : "";
      if (!address || !city || !zip) {
        showStatus("error", "Please enter address, city, and ZIP to continue.");
        return;
      }
      if (!/^\d{5}(-\d{4})?$/.test(zip)) {
        showStatus("error", "Please enter a valid ZIP code.");
        return;
      }
      status && (status.hidden = true);
      goStep(2);
    });

    backBtn?.addEventListener("click", () => {
      status && (status.hidden = true);
      goStep(1);
    });

    async function lookupAddress(query) {
      if (!mapToken || query.length < 5 || !(suggest instanceof HTMLElement)) {
        if (suggest instanceof HTMLElement) suggest.hidden = true;
        return;
      }
      try {
        const url = `https://api.mapbox.com/geocoding/v5/mapbox.places/${encodeURIComponent(
          query,
        )}.json?access_token=${encodeURIComponent(mapToken)}&country=US&types=address&limit=5`;
        const res = await fetch(url);
        if (!res.ok) return;
        const data = await res.json();
        const features = Array.isArray(data.features) ? data.features : [];
        suggest.innerHTML = "";
        if (!features.length) {
          suggest.hidden = true;
          return;
        }
        features.forEach((f) => {
          const btn = document.createElement("button");
          btn.type = "button";
          btn.textContent = f.place_name;
          btn.addEventListener("click", () => {
            const street = (f.address ? `${f.address} ` : "") + (f.text || "");
            const ctx = f.context || [];
            const city =
              ctx.find((c) => String(c.id).startsWith("place"))?.text ||
              ctx.find((c) => String(c.id).startsWith("locality"))?.text ||
              "";
            const zip = ctx.find((c) => String(c.id).startsWith("postcode"))?.text || "";
            if (addressInput instanceof HTMLInputElement) addressInput.value = street || f.place_name;
            if (cityInput instanceof HTMLInputElement) cityInput.value = city;
            if (zipInput instanceof HTMLInputElement) zipInput.value = zip;
            suggest.hidden = true;
          });
          suggest.appendChild(btn);
        });
        suggest.hidden = false;
      } catch {
        /* manual entry remains available */
      }
    }

    addressInput?.addEventListener("input", () => {
      clearTimeout(suggestTimer);
      const q = addressInput instanceof HTMLInputElement ? addressInput.value.trim() : "";
      suggestTimer = setTimeout(() => lookupAddress(q), 280);
    });

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (submitting || !(form instanceof HTMLFormElement)) return;
      submitting = true;
      if (submitBtn instanceof HTMLButtonElement) submitBtn.disabled = true;
      showStatus("pending", "Sending your request…");

      const fd = new FormData(form);
      const smsChecked = fd.get("sms_opt_in") === "Yes";
      const tracking = params();
      const userNotes = String(fd.get("notes") || "").trim();
      const extraNotes = (root.dataset.extraNotes || "").trim();
      const notes = [userNotes, extraNotes].filter(Boolean).join("\n");
      const disclosure = root.dataset.smsDisclosure || "";
      const pageUrl = location.href;
      const payload = {
        name: String(fd.get("name") || ""),
        email: String(fd.get("email") || ""),
        phone: String(fd.get("phone") || ""),
        address: String(fd.get("address") || ""),
        city: String(fd.get("city") || ""),
        zip: String(fd.get("zip") || ""),
        state: String(fd.get("state") || "LA"),
        notes,
        website: String(fd.get("website") || ""),
        sms_opt_in_status: smsChecked ? "Yes" : "No",
        promotional_sms_opt_in: smsChecked,
        promotional_sms_disclosure: disclosure,
        lead_source: root.dataset.leadSource || "Website",
        source: root.dataset.source || "website-quote-form",
        promotion_code: root.dataset.promotion || "",
        page_url: pageUrl,
        event_source_url: pageUrl,
        browser_event_id: idempotencyKey,
        submitted_at: new Date().toISOString(),
        idempotency_key: idempotencyKey,
        ...tracking,
      };

      try {
        const res = await fetch("/api/leads/website/", {
          method: "POST",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify(payload),
        });
        const data = await res.json().catch(() => ({}));

        if (!res.ok || !data.ok || data.customer_id == null || data.customer_id === "") {
          const msg =
            data.message ||
            "We could not confirm your request. Your information is still on this form — please try again or call (225) 461-3199.";
          showStatus("error", msg);
          return;
        }

        if (!conversionFired && typeof window.ggwcTrack === "function") {
          window.ggwcTrack("ggwc_lead_accepted", {
            customer_id: data.customer_id,
            mocked: !!data.mocked,
          });
          conversionFired = true;
        }

        showStatus(
          "success",
          data.mocked
            ? "Request accepted in mock mode (no live CRM). Configure CRM credentials for production delivery."
            : "Thank you — your estimate request was received. Our local team will follow up during business hours.",
        );
        form.querySelectorAll("input, textarea, button").forEach((el) => {
          if (el instanceof HTMLInputElement || el instanceof HTMLTextAreaElement || el instanceof HTMLButtonElement) {
            if (el.name !== "website") el.disabled = true;
          }
        });
      } catch {
        showStatus(
          "error",
          "Network error — we could not confirm submission. Please call (225) 461-3199. Your answers are still filled in.",
        );
      } finally {
        submitting = false;
        if (submitBtn instanceof HTMLButtonElement && !conversionFired) submitBtn.disabled = false;
        if (conversionFired) idempotencyKey = uuid();
      }
    });
  });
</script>
