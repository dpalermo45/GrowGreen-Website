<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<script>
  const root = document.querySelector<HTMLElement>("[data-svc-page]");
  if (root && root.dataset.initialized !== "true") {
    root.dataset.initialized = "true";

    const notes = root.querySelector<HTMLTextAreaElement>('textarea[name="notes"]');
    const options = root.querySelector<HTMLElement>("[data-service-options]");
    const selectedCount = root.querySelector<HTMLElement>("[data-selected-count]");
    const resultCount = root.querySelector<HTMLElement>("[data-result-count]");
    const PREFIX = "Services requested: ";

    function selectedServices() {
      if (!options) return [] as string[];
      return Array.from(options.querySelectorAll<HTMLButtonElement>('[data-service-option][aria-pressed="true"]')).map(
        (button) => button.dataset.serviceOption || "",
      ).filter(Boolean);
    }

    function syncNotes() {
      if (!notes) return;
      const selected = selectedServices();
      const lines = (notes.value || "")
        .split("\n")
        .map((line) => line.trim())
        .filter(Boolean)
        .filter((line) => !line.startsWith(PREFIX));
      if (selected.length) lines.unshift(`${PREFIX}${selected.join(", ")}`);
      notes.value = lines.join("\n");
    }

    function syncSelection() {
      const selected = selectedServices();
      if (selectedCount) {
        selectedCount.textContent = `${selected.length} selected`;
      }
      root.querySelectorAll<HTMLButtonElement>("[data-add-service]").forEach((button) => {
        const isAdded = selected.includes(button.dataset.addService || "");
        button.classList.toggle("is-added", isAdded);
        const featured = Boolean(button.closest(".svc-card--featured"));
        button.textContent = isAdded
          ? "Added to quote"
          : featured
            ? "Add to my quote"
            : "Add to quote";
      });
      syncNotes();
    }

    function setService(service: string, selected: boolean) {
      const button = Array.from(options?.querySelectorAll<HTMLButtonElement>("[data-service-option]") || []).find(
        (option) => option.dataset.serviceOption === service,
      );
      if (!button) return false;
      button.setAttribute("aria-pressed", selected ? "true" : "false");
      syncSelection();
      return true;
    }

    function addServices(services: string[], shouldScroll: boolean) {
      services.forEach((service) => setService(service, true));
      if (shouldScroll) {
        document.getElementById("svc-quote")?.scrollIntoView({ behavior: "smooth", block: "start" });
        window.setTimeout(() => {
          const first = options?.querySelector<HTMLButtonElement>('[aria-pressed="true"]');
          first?.focus({ preventScroll: true });
        }, 500);
      }
    }

    function filterServices(filter: string) {
      let visible = 0;
      root.querySelectorAll<HTMLElement>("[data-service-card]").forEach((card) => {
        const categories = (card.dataset.category || "").split(/\s+/);
        const show = filter === "all" || categories.includes(filter);
        card.hidden = !show;
        if (show) visible += 1;
      });
      root.querySelectorAll<HTMLButtonElement>("[data-filter]").forEach((button) => {
        button.setAttribute("aria-pressed", button.dataset.filter === filter ? "true" : "false");
      });
      if (resultCount) {
        resultCount.textContent = `Showing ${visible} ${visible === 1 ? "service" : "services"}`;
      }
    }

    options?.addEventListener("click", (event) => {
      const button = (event.target as HTMLElement | null)?.closest<HTMLButtonElement>("[data-service-option]");
      if (!button) return;
      const pressed = button.getAttribute("aria-pressed") === "true";
      button.setAttribute("aria-pressed", pressed ? "false" : "true");
      syncSelection();
    });

    root.querySelectorAll<HTMLButtonElement>("[data-add-service]").forEach((button) => {
      button.addEventListener("click", () => {
        const service = button.dataset.addService || "";
        if (!service) return;
        const already = selectedServices().includes(service);
        setService(service, !already);
        if (!already) {
          document.getElementById("svc-quote")?.scrollIntoView({ behavior: "smooth", block: "start" });
        }
      });
    });

    root.querySelectorAll<HTMLButtonElement>("[data-select-services]").forEach((button) => {
      button.addEventListener("click", () => {
        const services = (button.dataset.selectServices || "").split("|").filter(Boolean);
        addServices(services, true);
      });
    });

    root.querySelectorAll<HTMLButtonElement>("[data-filter]").forEach((button) => {
      button.addEventListener("click", () => filterServices(button.dataset.filter || "all"));
    });

    root.querySelectorAll<HTMLButtonElement>("[data-filter-jump]").forEach((button) => {
      button.addEventListener("click", () => {
        filterServices(button.dataset.filterJump || "all");
        document.getElementById("svc-services")?.scrollIntoView({ behavior: "smooth", block: "start" });
      });
    });

    const params = new URLSearchParams(window.location.search);
    const requested = params.get("service");
    if (requested) setService(requested, true);

    syncSelection();
    filterServices("all");
  }
</script>
