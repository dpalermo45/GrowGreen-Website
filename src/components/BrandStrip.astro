---
import { site } from "../data/site";

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<aside class:list={["brand-strip", compact && "compact"]}>
  <div class="brand-strip-inner">
    <img
      class="mascot"
      src="/images/mascot/thumbs-up.png"
      width="120"
      height="120"
      alt="Grow Green mascot"
      loading="lazy"
    />
    <div class="brand-copy-block">
      <p class="brand-name">{site.name}</p>
      <p class="brand-copy">
        Firefighter-owned lawn treatment specialists for South Louisiana —
        local timing, clear communication, and care built around warm-season turf.
      </p>
      <ul>
        {site.identity.map((item) => <li>{item}</li>)}
      </ul>
    </div>
    <img
      class="photo"
      src="/images/hero/truck-and-trailer.webp"
      width="280"
      height="180"
      alt="Grow Green Weed Control truck and trailer"
      loading="lazy"
    />
  </div>
</aside>

<style>
  .brand-strip {
    margin: 2rem 0;
    background:
      radial-gradient(circle at 88% 12%, rgba(77, 168, 95, 0.2), transparent 30%),
      radial-gradient(circle at 10% 90%, rgba(242, 170, 43, 0.08), transparent 34%),
      linear-gradient(135deg, #071d11 0%, #0b2817 58%, #10351f 100%);
    color: #fff;
    border-radius: 18px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }
  .brand-strip-inner {
    display: grid;
    gap: 1rem 1.15rem;
    align-items: center;
    padding: 1.35rem 1.4rem;
  }
  @media (min-width: 900px) {
    .brand-strip-inner {
      grid-template-columns: auto 1fr minmax(180px, 260px);
      gap: 1.25rem 1.5rem;
    }
  }
  .mascot {
    width: 96px;
    height: auto;
    justify-self: start;
  }
  .brand-name {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 900;
    margin: 0 0 0.35rem;
    color: #fff;
    letter-spacing: -0.02em;
  }
  .brand-copy {
    margin: 0 0 0.65rem;
    color: #dce8e0;
    line-height: 1.55;
  }
  .brand-strip ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.95rem;
  }
  .brand-strip li {
    font-weight: 800;
    font-size: 0.9rem;
    color: #f5d089;
  }
  .photo {
    width: 100%;
    height: 140px;
    object-fit: cover;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.12);
  }

  /* Compact — geo pages: denser, no photo, clearer contrast */
  .compact {
    margin: 0 0 1.5rem;
    border-radius: 14px;
  }
  .compact .brand-strip-inner {
    gap: 0.85rem 1rem;
    padding: 1rem 1.1rem;
  }
  @media (min-width: 700px) {
    .compact .brand-strip-inner {
      grid-template-columns: auto 1fr;
      align-items: start;
    }
  }
  .compact .photo {
    display: none;
  }
  .compact .mascot {
    width: 68px;
  }
  .compact .brand-name {
    font-size: 1.08rem;
    margin-bottom: 0.25rem;
  }
  .compact .brand-copy {
    margin-bottom: 0.5rem;
    font-size: 0.94rem;
    color: #e3eee6;
    line-height: 1.5;
  }
  .compact li {
    font-size: 0.82rem;
    color: #f0d48a;
  }
</style>
