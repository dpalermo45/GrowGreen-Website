---
import { site } from "../data/site";
import { primaryNav } from "../data/navigation";

const servicesItem = primaryNav.find((item) => item.children?.length);
const otherNav = primaryNav.filter((item) => item !== servicesItem);

/** Group services for a scannable mega menu (desktop). */
const serviceGroups = [
  {
    title: "Lawn & beds",
    items: [
      { label: "Lawn Fertilization & Weed Control", href: "/lawn-fertilization-weed-control/" },
      { label: "Flower Bed Weed Control", href: "/flower-bed-weed-control-and-fertilization/" },
      { label: "Tree & Shrub Care", href: "/tree-and-shrub-care/" },
    ],
  },
  {
    title: "Pests & disease",
    items: [
      { label: "Fire Ant Treatment", href: "/fire-ant-treatment/" },
      { label: "Mosquito, Flea & Tick", href: "/mosquito-flea-tick-treatments/" },
      { label: "Lawn Fungus & Insects", href: "/lawn-fungus-and-insects/" },
    ],
  },
  {
    title: "Soil health",
    items: [
      { label: "Soil Sampling", href: "/soil-sample/" },
      { label: "Liquid Aeration", href: "/liquid-aeration/" },
      { label: "Core Aeration", href: "/core-aeration/" },
    ],
  },
] as const;
---

{/* Utility bar scrolls away; sticky header is only the main nav surface. */}
<div class="topbar">
  <div class="container topbar-inner">
    <p>Locally owned &amp; operated · Serving South Louisiana</p>
    <div class="topbar-links">
      <a href="/customer-login-pay-bill/">Customer Login</a>
    </div>
  </div>
</div>

<header class="site-header">
  <button
    type="button"
    class="nav-backdrop"
    data-nav-backdrop
    aria-label="Close menu"
    hidden
  ></button>
  <div class="container nav-inner">
    <a class="brand" href="/" aria-label={`${site.name} home`}>
      <img
        src="/images/brand/logo-128.webp"
        srcset="/images/brand/logo-64.webp 64w, /images/brand/logo-128.webp 128w, /images/brand/logo-192.webp 192w"
        sizes="58px"
        width="58"
        height="58"
        alt="Grow Green Weed Control"
        decoding="async"
      />
      <span class="brand-text">
        <strong>Grow Green</strong>
        <small>Weed Control</small>
      </span>
    </a>
    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      data-nav-toggle
    >
      <span data-nav-toggle-label>Menu</span>
    </button>
    <nav id="site-nav" class="site-nav" data-site-nav>
      <ul class="nav-list">
        {
          servicesItem && (
            <li class="has-children" data-nav-item="parent">
              <button
                type="button"
                class="nav-parent"
                aria-expanded="false"
                aria-haspopup="true"
                data-nav-parent
              >
                {servicesItem.label}
                <span class="chev" aria-hidden="true"></span>
              </button>
              <div class="submenu submenu--mega" data-submenu hidden>
                <div class="submenu-head">
                  <p>Our services</p>
                  <a class="submenu-hub" href={servicesItem.href}>View all services →</a>
                </div>
                <div class="submenu-grid">
                  {serviceGroups.map((group) => (
                    <div class="submenu-group">
                      <p class="submenu-group__title">{group.title}</p>
                      <ul>
                        {group.items.map((child) => (
                          <li>
                            <a href={child.href}>{child.label}</a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
              </div>
            </li>
          )
        }
        {
          otherNav.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
        <li class="mobile-only mobile-only--cta">
          <a class="mobile-quote" href="/request-a-quote/">Get My Free Quote</a>
        </li>
        <li class="mobile-only">
          <a href={`tel:${site.phoneTel}`}>Call {site.phone}</a>
        </li>
        <li class="mobile-only">
          <a href="/customer-login-pay-bill/">Customer Login</a>
        </li>
      </ul>
    </nav>
    <div class="nav-cta">
      <a class="phone" href={`tel:${site.phoneTel}`}>
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none">
          <path
            d="M7.2 3.8h2.4l1.1 3.2-1.5 1.5a12.5 12.5 0 0 0 5.3 5.3l1.5-1.5 3.2 1.1v2.4c0 .7-.5 1.2-1.2 1.3A15.7 15.7 0 0 1 3.5 5c.1-.7.6-1.2 1.3-1.2Z"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linejoin="round"
          ></path>
        </svg>
        <span>{site.phone}</span>
      </a>
      <a class="btn btn-green quote-btn" href="/request-a-quote/">
        <span class="quote-full">Get My Free Quote</span>
        <span class="quote-short">Free Quote</span>
      </a>
    </div>
  </div>
</header>

<style>
  .topbar {
    background: linear-gradient(180deg, #0a1f12 0%, var(--green-900) 100%);
    color: rgba(255, 255, 255, 0.82);
    font-size: 0.8rem;
    min-height: var(--topbar-h);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }
  .topbar-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.25rem;
    min-height: var(--topbar-h);
    padding: 0;
    flex-wrap: nowrap;
  }
  .topbar p {
    margin: 0;
    font-weight: 600;
    letter-spacing: 0.01em;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .topbar a {
    color: rgba(255, 255, 255, 0.78);
    text-decoration: none;
    font-weight: 700;
    min-height: 2.25rem;
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    flex-shrink: 0;
    letter-spacing: 0.02em;
    border-bottom: 1px solid transparent;
    transition: color 0.16s ease, border-color 0.16s ease;
  }
  .topbar a:hover,
  .topbar a:focus-visible {
    color: #fff;
    border-bottom-color: rgba(255, 255, 255, 0.45);
    outline: none;
  }
  .topbar-links {
    display: flex;
    gap: 1rem;
    align-items: center;
    flex-shrink: 0;
  }
  @media (max-width: 640px) {
    .topbar {
      font-size: 0.72rem;
    }
    .topbar p {
      max-width: 58vw;
    }
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 200;
    /* Opaque surface — avoid backdrop-filter/isolation here; they clip the
       absolute/fixed mobile panel once the sticky header is stuck mid-page. */
    background-color: #ffffff;
    background-image: none;
    overflow: visible;
    border-bottom: 1px solid #e4eee7;
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.8), 0 8px 24px rgba(15, 42, 26, 0.04);
  }
  .nav-inner {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: var(--header-h);
    padding: 0.55rem 0;
    overflow: visible;
    /* Must stay above .nav-backdrop or the gray overlay intercepts menu taps. */
    z-index: 260;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--ink);
    flex-shrink: 0;
  }
  .brand img {
    width: auto;
    height: 52px;
    max-width: 52px;
    object-fit: contain;
  }
  .brand-text {
    display: grid;
    gap: 0.08rem;
    line-height: 1.05;
  }
  .brand-text strong {
    font-size: 1.1rem;
    font-weight: 900;
    letter-spacing: -0.032em;
    color: var(--green-900);
  }
  .brand-text small {
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #6a7d71;
  }
  .site-nav {
    margin-left: auto;
  }
  .nav-list {
    list-style: none;
    display: flex;
    gap: 0.1rem;
    margin: 0;
    padding: 0;
    align-items: center;
  }
  .nav-list > li {
    position: relative;
  }
  .site-nav > .nav-list > li > a,
  .nav-parent {
    display: inline-flex;
    align-items: center;
    gap: 0.38rem;
    padding: 0.45rem 0.72rem;
    min-height: 42px;
    color: #3a4d41;
    text-decoration: none;
    font: inherit;
    font-weight: 650;
    background: transparent;
    border: 0;
    cursor: pointer;
    border-radius: 0.6rem;
    font-size: 0.935rem;
    letter-spacing: -0.012em;
    white-space: nowrap;
    transition: background 0.16s ease, color 0.16s ease;
  }
  .chev {
    width: 0.4rem;
    height: 0.4rem;
    margin-top: -0.1rem;
    border-right: 1.8px solid currentColor;
    border-bottom: 1.8px solid currentColor;
    transform: rotate(45deg);
    opacity: 0.55;
    transition: transform 0.18s ease, margin-top 0.18s ease, opacity 0.18s ease;
  }
  .nav-parent[aria-expanded="true"] .chev {
    margin-top: 0.12rem;
    transform: rotate(225deg);
    opacity: 1;
  }
  .nav-parent:hover,
  .site-nav > .nav-list > li > a:hover,
  .nav-parent[aria-expanded="true"],
  .site-nav > .nav-list > li > a:focus-visible,
  .nav-parent:focus-visible {
    background: var(--green-50);
    color: var(--green-900);
    outline: none;
  }

  .submenu--mega {
    position: absolute;
    top: calc(100% + 0.55rem);
    left: 0;
    width: min(40rem, calc(100vw - 2rem));
    background: #fff;
    border: 1px solid #dbe6de;
    border-radius: 1.05rem;
    box-shadow: 0 22px 48px rgba(17, 45, 27, 0.14);
    padding: 1rem 1.05rem 1.1rem;
    z-index: 70;
    transform-origin: top left;
  }
  .submenu--mega:not([hidden]) {
    animation: nav-submenu-in 0.18s ease-out;
  }
  @keyframes nav-submenu-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .submenu--mega:not([hidden]) {
      animation: none;
    }
    .chev,
    .phone,
    .nav-cta .quote-btn,
    .site-nav > .nav-list > li > a,
    .nav-parent {
      transition: none;
    }
    .nav-cta .quote-btn:hover {
      transform: none;
    }
  }
  .submenu[hidden] {
    display: none !important;
  }
  .submenu-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.9rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid #e4eee6;
  }
  .submenu-head p {
    margin: 0;
    color: #5f7466;
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .submenu-hub {
    color: var(--green-700);
    font-size: 0.88rem;
    font-weight: 900;
    text-decoration: none;
  }
  .submenu-hub:hover {
    color: var(--green-900);
  }
  .submenu-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.35rem 0;
  }
  .submenu-group {
    padding: 0 0.85rem;
  }
  .submenu-group:first-child {
    padding-left: 0.15rem;
  }
  .submenu-group:last-child {
    padding-right: 0.15rem;
  }
  .submenu-group + .submenu-group {
    border-left: 1px solid #e7efe9;
  }
  .submenu-group__title {
    margin: 0 0 0.45rem;
    color: var(--green-800);
    font-size: 0.76rem;
    font-weight: 900;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .submenu-group ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.12rem;
  }
  .submenu-group a {
    display: block;
    padding: 0.48rem 0.55rem;
    border-radius: 0.55rem;
    color: var(--ink);
    text-decoration: none;
    font-size: 0.88rem;
    font-weight: 700;
    line-height: 1.3;
    transition: background 0.14s ease, color 0.14s ease;
  }
  .submenu-group a:hover,
  .submenu-group a:focus-visible {
    background: var(--green-50);
    color: var(--green-900);
    outline: none;
  }

  .nav-cta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
    margin-left: 0.85rem;
    padding-left: 1.05rem;
    border-left: 1px solid #dce8e0;
  }
  .phone {
    display: inline-flex;
    align-items: center;
    gap: 0.42rem;
    min-height: 42px;
    padding: 0.35rem 0.45rem;
    border: 0;
    border-radius: 0.55rem;
    background: transparent;
    color: var(--green-800);
    text-decoration: none;
    font-weight: 750;
    font-size: 0.9rem;
    letter-spacing: -0.012em;
    white-space: nowrap;
    transition: color 0.16s ease, background 0.16s ease;
  }
  .phone:hover,
  .phone:focus-visible {
    color: var(--green-950);
    background: var(--green-50);
    outline: none;
  }
  .phone:focus-visible {
    outline: 2px solid rgba(47, 122, 67, 0.35);
    outline-offset: 2px;
  }
  .phone svg {
    flex-shrink: 0;
    color: var(--green-700);
  }
  .nav-cta .quote-btn {
    padding: 0.65rem 1.2rem;
    font-size: 0.9rem;
    font-weight: 850;
    min-height: 44px;
    border-radius: 0.7rem;
    white-space: nowrap;
    box-shadow: 0 4px 14px rgba(15, 55, 30, 0.12);
    transition: transform 0.16s ease, box-shadow 0.16s ease, background-color 0.16s ease;
  }
  .nav-cta .quote-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 18px rgba(15, 55, 30, 0.16);
  }
  .quote-short {
    display: none;
  }
  .nav-toggle {
    display: none;
    position: relative;
    z-index: 2;
    margin-left: auto;
    border: 0;
    background: var(--green-800);
    color: #fff;
    border-radius: 0.7rem;
    padding: 0.55rem 1rem;
    font-weight: 850;
    min-height: 44px;
    align-items: center;
    box-shadow: 0 4px 12px rgba(15, 55, 30, 0.12);
  }
  .mobile-only {
    display: none;
  }

  @media (max-width: 1360px) {
    .quote-full {
      display: none;
    }
    .quote-short {
      display: inline;
    }
  }

  @media (max-width: 1280px) {
    .brand-text {
      display: none;
    }
    .nav-cta .phone span {
      display: none;
    }
    .nav-cta .phone {
      padding: 0.45rem;
      border: 1px solid #cfe0d3;
      border-radius: 0.55rem;
      background: #f7faf7;
    }
  }

  /* Collapse earlier so tablet / small laptop never wrap the full desktop row */
  @media (max-width: 1220px) {
    .nav-toggle {
      display: inline-flex;
    }
    .nav-backdrop {
      display: none;
      position: fixed;
      /* Sit under the sticky header only — do not dim the menu or Close button. */
      top: var(--nav-panel-top, var(--header-h));
      right: 0;
      bottom: 0;
      left: 0;
      z-index: 240;
      margin: 0;
      padding: 0;
      border: 0;
      background: rgba(10, 28, 16, 0.28);
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
    }
    .nav-backdrop.is-open {
      display: block;
    }
    .site-nav {
      display: none;
      /* Fixed dropdown under the sticky header — height follows content so the
         page/backdrop stay tappable and the menu is not a full-screen trap. */
      position: fixed;
      left: 0;
      right: 0;
      top: var(--nav-panel-top, var(--header-h));
      bottom: auto;
      background: #ffffff;
      padding: 0.85rem 1rem 1.1rem;
      border-bottom: 1px solid #dfe8e1;
      box-shadow: 0 12px 28px rgba(15, 42, 26, 0.12);
      z-index: 250;
      margin: 0;
      max-height: min(75dvh, calc(100dvh - var(--nav-panel-top, var(--header-h)) - 0.75rem));
      overflow: auto;
      -webkit-overflow-scrolling: touch;
      padding-bottom: max(1.1rem, env(safe-area-inset-bottom));
      pointer-events: auto;
    }
    .site-nav.open {
      display: block;
    }
    .nav-list {
      flex-direction: column;
      align-items: stretch;
      gap: 0.2rem;
    }
    .site-nav > .nav-list > li > a,
    .nav-parent {
      width: 100%;
      justify-content: space-between;
      font-size: 0.98rem;
      padding: 0.75rem 0.8rem;
    }
    .submenu--mega {
      position: static;
      width: auto;
      box-shadow: none;
      border: 0;
      border-radius: 0;
      padding: 0.35rem 0 0.45rem 0.35rem;
      margin: 0;
    }
    .submenu-head {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.35rem;
      margin-bottom: 0.55rem;
      padding: 0 0.45rem 0.55rem;
    }
    .submenu-grid {
      grid-template-columns: 1fr;
      gap: 0.65rem;
    }
    .submenu-group {
      padding: 0.35rem 0.45rem 0.55rem;
      border-radius: 0.7rem;
      background: #f7faf7;
    }
    .nav-cta {
      display: none;
    }
    .mobile-only {
      display: list-item;
    }
    .mobile-only a {
      color: var(--green-800);
      font-weight: 800;
    }
    .mobile-only--cta {
      margin-top: 0.35rem;
    }
    .mobile-quote {
      justify-content: center !important;
      background: var(--green-800) !important;
      color: #fff !important;
      border-radius: 0.7rem;
    }
  }

  @media (max-width: 520px) {
    .brand img {
      height: 48px;
      max-width: 48px;
    }
  }
</style>

<script>
  const toggle = document.querySelector("[data-nav-toggle]");
  const toggleLabel = document.querySelector("[data-nav-toggle-label]");
  const nav = document.querySelector("[data-site-nav]");
  const backdrop = document.querySelector("[data-nav-backdrop]");
  const parents = document.querySelectorAll("[data-nav-item='parent']");

  function closeAll(except) {
    parents.forEach((item) => {
      if (item === except) return;
      const btn = item.querySelector("[data-nav-parent]");
      const menu = item.querySelector("[data-submenu]");
      btn?.setAttribute("aria-expanded", "false");
      if (menu) menu.hidden = true;
    });
  }

  function openItem(item) {
    const btn = item.querySelector("[data-nav-parent]");
    const menu = item.querySelector("[data-submenu]");
    closeAll(item);
    btn?.setAttribute("aria-expanded", "true");
    if (menu) menu.hidden = false;
  }

  function closeItem(item) {
    const btn = item.querySelector("[data-nav-parent]");
    const menu = item.querySelector("[data-submenu]");
    btn?.setAttribute("aria-expanded", "false");
    if (menu) menu.hidden = true;
  }

  function syncNavPanelTop() {
    const header = document.querySelector(".site-header");
    if (!(header instanceof HTMLElement)) return;
    const bottom = Math.ceil(header.getBoundingClientRect().bottom);
    document.documentElement.style.setProperty("--nav-panel-top", `${bottom}px`);
  }

  function setNavOpen(open) {
    if (open) syncNavPanelTop();
    else document.documentElement.style.removeProperty("--nav-panel-top");
    nav?.classList.toggle("open", open);
    backdrop?.classList.toggle("is-open", open);
    if (backdrop instanceof HTMLElement) backdrop.hidden = !open;
    toggle?.setAttribute("aria-expanded", open ? "true" : "false");
    if (toggleLabel) toggleLabel.textContent = open ? "Close" : "Menu";
    // Do not lock html/body overflow — that trapped users mid-scroll with no
    // way to dismiss except picking a nav link.
    if (!open) closeAll();
  }

  toggle?.addEventListener("click", () => {
    const open = !nav?.classList.contains("open");
    setNavOpen(open);
  });

  backdrop?.addEventListener("click", () => setNavOpen(false));

  parents.forEach((item) => {
    const btn = item.querySelector("[data-nav-parent]");
    const menu = item.querySelector("[data-submenu]");
    let leaveTimer;

    btn?.addEventListener("click", (event) => {
      event.preventDefault();
      const expanded = btn.getAttribute("aria-expanded") === "true";
      if (expanded) closeItem(item);
      else openItem(item);
    });

    item.addEventListener("mouseenter", () => {
      if (window.matchMedia("(max-width: 1220px)").matches) return;
      clearTimeout(leaveTimer);
      openItem(item);
    });

    item.addEventListener("mouseleave", () => {
      if (window.matchMedia("(max-width: 1220px)").matches) return;
      leaveTimer = setTimeout(() => closeItem(item), 140);
    });

    menu?.addEventListener("mouseenter", () => clearTimeout(leaveTimer));
  });

  document.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof Node)) return;
    if (nav?.contains(target) || toggle?.contains(target) || backdrop?.contains(target)) {
      return;
    }
    setNavOpen(false);
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    setNavOpen(false);
  });

  window.addEventListener("resize", () => {
    if (window.matchMedia("(min-width: 1221px)").matches) {
      setNavOpen(false);
      return;
    }
    if (nav?.classList.contains("open")) syncNavPanelTop();
  });

  window.addEventListener(
    "scroll",
    () => {
      if (nav?.classList.contains("open")) syncNavPanelTop();
    },
    { passive: true },
  );
</script>
