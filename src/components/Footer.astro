---
import { site } from "../data/site";
import { serviceAreas } from "../data/service-areas";

const year = new Date().getFullYear();

const serviceLinks = [
  { label: "Lawn Fertilization & Weed Control", href: "/lawn-fertilization-weed-control/" },
  { label: "Flower Bed Weed Control", href: "/flower-bed-weed-control-and-fertilization/" },
  { label: "Fire Ant Control", href: "/fire-ant-treatment/" },
  { label: "Tree & Shrub Care", href: "/tree-and-shrub-care/" },
  { label: "Core Aeration", href: "/core-aeration/" },
  { label: "Liquid Aeration", href: "/liquid-aeration/" },
  { label: "Mosquito, Flea & Tick", href: "/mosquito-flea-tick-treatments/" },
];

const companyLinks = [
  { label: "About Us", href: "/about-us/" },
  { label: "Lawn Tips", href: "/lawn-care-blog/" },
  { label: "Contact", href: "/contact-us/" },
  { label: "Careers", href: "/careers/" },
  { label: "Request a Quote", href: "/request-a-quote/" },
  { label: "Customer Login", href: "/customer-login-pay-bill/" },
];

/** Footer strip: primary markets only — full list lives on /service-areas/. */
const footerAreaSlugs = [
  "st-amant",
  "prairieville",
  "gonzales",
  "baton-rouge",
  "denham-springs",
  "walker",
  "central",
  "zachary",
  "geismar",
  "dutchtown",
] as const;

const footerAreaOrder = new Map(footerAreaSlugs.map((slug, i) => [slug, i]));
const areaLinks = serviceAreas
  .filter((a) => footerAreaOrder.has(a.slug))
  .sort((a, b) => (footerAreaOrder.get(a.slug) ?? 0) - (footerAreaOrder.get(b.slug) ?? 0))
  .map((a) => ({ label: a.name, href: `/service-areas/${a.slug}/` }));

const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(site.address.full)}`;
---

<footer id="gg-footer-2026" class="site-footer" aria-label="Grow Green Weed Control footer">
  <div class="ggf26-shell">
    <div class="ggf26-main">
      <section class="ggf26-brand" aria-label="About Grow Green Weed Control">
        <a class="ggf26-brand-lockup" href="/" aria-label={`${site.name} — Home`}>
          <span class="ggf26-logo-box">
            <img
              src="/images/brand/logo-128.webp"
              alt=""
              width="64"
              height="64"
              decoding="async"
            />
          </span>
          <span class="ggf26-brand-name">Grow Green<br />Weed Control</span>
        </a>

        <p class="ggf26-brand-copy">
          Local fertilization, weed control, and outdoor treatments for warm-season South Louisiana lawns.
        </p>

        <ul class="ggf26-trust" aria-label="Why homeowners choose Grow Green">
          <li>
            <a href={site.social.google} target="_blank" rel="noopener noreferrer">Google reviews</a>
          </li>
          <li>Firefighter-owned</li>
          <li>Family-operated</li>
        </ul>
      </section>

      <nav class="ggf26-nav" aria-label="Lawn care services">
        <h3 class="ggf26-heading">Our Services</h3>
        <ul class="ggf26-links">
          {
            serviceLinks.map((l) => (
              <li>
                <a href={l.href}>{l.label}</a>
              </li>
            ))
          }
        </ul>
        <a class="ggf26-more" href="/services/">View all services →</a>
      </nav>

      <nav class="ggf26-nav" aria-label="Company links">
        <h3 class="ggf26-heading">Company</h3>
        <ul class="ggf26-links">
          {
            companyLinks.map((l) => (
              <li>
                <a href={l.href}>{l.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <section class="ggf26-contact" aria-label="Talk with our team">
        <h3 class="ggf26-heading">Talk With Our Team</h3>

        <a class="ggf26-phone" href={`tel:${site.phoneTel}`}>{site.phone}</a>
        <p class="ggf26-phone-note">Call or text · {site.hours.label}</p>

        <div class="ggf26-contact-stack">
          <a class="ggf26-mail" href={`mailto:${site.email}`}>{site.email}</a>
          <p class="ggf26-office">
            {site.address.street}<br />
            {site.address.city}, {site.address.state} {site.address.zip}
          </p>
          <a class="ggf26-directions" href={mapsUrl} target="_blank" rel="noopener noreferrer">
            Get directions →
          </a>
        </div>

        <nav class="ggf26-socials" aria-label="Social links">
          <a href={site.social.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook" title="Facebook">
            <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" focusable="false">
              <path
                fill="currentColor"
                d="M14 6.1h2.4V2.2C15.9 2.1 14.7 2 13.4 2 10.6 2 8.7 3.7 8.7 6.9V10H5.3v4.4h3.4V22h4.2v-7.6h3.4l.5-4.4h-3.9V7.2c0-1.3.4-2.1 2.1-2.1z"
              ></path>
            </svg>
          </a>
          <a href={site.social.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram" title="Instagram">
            <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" focusable="false">
              <path
                fill="currentColor"
                d="M12 7.2A4.8 4.8 0 1 0 12 16.8 4.8 4.8 0 0 0 12 7.2zm0 7.9a3.1 3.1 0 1 1 0-6.2 3.1 3.1 0 0 1 0 6.2zm6.1-8.1a1.1 1.1 0 1 1-2.2 0 1.1 1.1 0 0 1 2.2 0zM12 3.6c-2.3 0-2.6 0-3.5.1-.9 0-1.5.2-2 .4a4 4 0 0 0-1.5 1 4 4 0 0 0-1 1.5c-.2.5-.3 1.1-.4 2-.1.9-.1 1.2-.1 3.5s0 2.6.1 3.5c0 .9.2 1.5.4 2a4 4 0 0 0 1 1.5 4 4 0 0 0 1.5 1c.5.2 1.1.3 2 .4.9.1 1.2.1 3.5.1s2.6 0 3.5-.1c.9 0 1.5-.2 2-.4a4 4 0 0 0 1.5-1 4 4 0 0 0 1-1.5c.2-.5.3-1.1.4-2 .1-.9.1-1.2.1-3.5s0-2.6-.1-3.5c0-.9-.2-1.5-.4-2a4 4 0 0 0-1-1.5 4 4 0 0 0-1.5-1c-.5-.2-1.1-.3-2-.4-.9-.1-1.2-.1-3.5-.1zm0 1.6c2.2 0 2.5 0 3.4.1.8 0 1.3.2 1.6.3.4.2.7.3 1 .6.3.3.5.6.6 1 .1.3.3.8.3 1.6.1.9.1 1.2.1 3.4s0 2.5-.1 3.4c0 .8-.2 1.3-.3 1.6-.2.4-.3.7-.6 1-.3.3-.6.5-1 .6-.3.1-.8.3-1.6.3-.9.1-1.2.1-3.4.1s-2.5 0-3.4-.1c-.8 0-1.3-.2-1.6-.3-.4-.2-.7-.3-1-.6-.3-.3-.5-.6-.6-1-.1-.3-.3-.8-.3-1.6-.1-.9-.1-1.2-.1-3.4s0-2.5.1-3.4c0-.8.2-1.3.3-1.6.2-.4.3-.7.6-1 .3-.3.6-.5 1-.6.3-.1.8-.3 1.6-.3.9-.1 1.2-.1 3.4-.1z"
              ></path>
            </svg>
          </a>
          <a href={site.social.nextdoor} target="_blank" rel="noopener noreferrer" aria-label="Nextdoor" title="Nextdoor">
            <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" focusable="false">
              <path
                fill="currentColor"
                d="M12.1 3.2 3.8 8.1v4.1l2.4-1.4v6h3.3v-4.1h5v4.1h3.3v-6l2.4 1.4V8.1l-8.1-4.9zm.1 7.3h-2.4V8.1h2.4v2.4z"
              ></path>
            </svg>
          </a>
          <a href={site.social.youtube} target="_blank" rel="noopener noreferrer" aria-label="YouTube" title="YouTube">
            <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" focusable="false">
              <path
                fill="currentColor"
                d="M21.6 7.8a2.7 2.7 0 0 0-1.9-1.9C17.9 5.5 12 5.5 12 5.5s-5.9 0-7.7.4A2.7 2.7 0 0 0 2.4 7.8 28.4 28.4 0 0 0 2 12a28.4 28.4 0 0 0 .4 4.2 2.7 2.7 0 0 0 1.9 1.9c1.8.4 7.7.4 7.7.4s5.9 0 7.7-.4a2.7 2.7 0 0 0 1.9-1.9A28.4 28.4 0 0 0 22 12a28.4 28.4 0 0 0-.4-4.2zM10.2 15.1V8.9l5.1 3.1-5.1 3.1z"
              ></path>
            </svg>
          </a>
        </nav>
      </section>
    </div>

    <div class="ggf26-areas" aria-label="Service areas">
      <p class="ggf26-areas-title">Proudly serving</p>
      <nav class="ggf26-area-list" aria-label="Lawn treatment by location">
        {
          areaLinks.map((l) => (
            <a href={l.href}>{l.label}</a>
          ))
        }
        <a class="ggf26-area-more" href="/service-areas/">View all 40 areas →</a>
      </nav>
    </div>

    <div class="ggf26-bottom">
      <p>© {year} {site.name}. All rights reserved.</p>
      <nav class="ggf26-bottom-links" aria-label="Legal links">
        <a href="/terms-and-conditions/">Terms &amp; Conditions</a>
        <a href="/privacy-policy/">Privacy Policy</a>
        <a href="/sitemap.xml">Sitemap</a>
      </nav>
    </div>
  </div>
</footer>

<style>
  #gg-footer-2026 {
    --ggf-green: #2f8b3a;
    --ggf-forest: #07180d;
    --ggf-muted: #a9b9ad;
    --ggf-line: rgba(255, 255, 255, 0.08);
    --ggf-gold: #f2ad2f;
    --ggf-ease: 200ms cubic-bezier(0.22, 1, 0.36, 1);

    position: relative;
    width: 100%;
    overflow: hidden;
    color: #fff;
    background:
      radial-gradient(ellipse 46% 36% at 6% 0%, rgba(47, 139, 58, 0.16), transparent 58%),
      linear-gradient(180deg, #0c2214 0%, var(--ggf-forest) 78%);
    isolation: isolate;
  }
  #gg-footer-2026::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(242, 173, 47, 0.32), transparent);
    pointer-events: none;
  }
  #gg-footer-2026 a {
    text-decoration: none;
  }
  #gg-footer-2026 img {
    display: block;
  }
  #gg-footer-2026 ul,
  #gg-footer-2026 li {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  #gg-footer-2026 p,
  #gg-footer-2026 h3 {
    margin: 0;
  }

  .ggf26-shell {
    position: relative;
    z-index: 1;
    width: min(100% - 40px, 1180px);
    margin-inline: auto;
  }
  .ggf26-main {
    display: grid;
    grid-template-columns: 1.28fr 0.96fr 0.76fr 1.12fr;
    gap: clamp(1.85rem, 3.4vw, 3rem);
    padding: clamp(2.9rem, 5.2vw, 3.75rem) 0 2rem;
    align-items: start;
  }

  .ggf26-brand-lockup {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    color: #fff;
  }
  .ggf26-logo-box {
    width: 3.55rem;
    height: 3.55rem;
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    padding: 0.3rem;
    background: #fff;
    border-radius: 0.75rem;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.18);
  }
  .ggf26-logo-box img {
    width: auto;
    height: 2.55rem;
    max-width: 100%;
    object-fit: contain;
  }
  .ggf26-brand-name {
    color: #fff;
    font-size: 1.08rem;
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }
  .ggf26-brand-copy {
    max-width: 19.5rem;
    margin-top: 1rem;
    color: var(--ggf-muted);
    font-size: 0.875rem;
    font-weight: 550;
    line-height: 1.62;
  }

  /* Quieter than pills — matches hero trust polish */
  .ggf26-trust {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0;
    margin-top: 1.15rem;
    color: #b7c6ba;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.01em;
  }
  .ggf26-trust li {
    display: inline-flex;
    align-items: center;
  }
  .ggf26-trust li:not(:last-child)::after {
    content: "·";
    margin-inline: 0.55rem;
    color: rgba(255, 255, 255, 0.28);
    font-weight: 900;
  }
  .ggf26-trust a {
    color: #cfe0d2;
    transition: color var(--ggf-ease);
  }
  .ggf26-trust a:hover {
    color: var(--ggf-gold);
  }

  #gg-footer-2026 .ggf26-heading {
    position: relative;
    margin: 0.1rem 0 0.95rem;
    padding: 0 0 0.7rem;
    color: #f4f7f4;
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }
  #gg-footer-2026 .ggf26-heading::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    width: 2.4rem;
    height: 2px;
    border-radius: 99px;
    background: linear-gradient(90deg, var(--ggf-gold), rgba(242, 173, 47, 0.15));
  }

  .ggf26-links {
    display: grid;
    gap: 0.05rem;
  }
  .ggf26-links a {
    display: flex;
    align-items: center;
    min-height: 1.95rem;
    padding: 0.08rem 0;
    color: #a8b8ac;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.3;
    transition: color var(--ggf-ease), transform var(--ggf-ease);
  }
  .ggf26-links a:hover {
    color: #fff;
    transform: translateX(2px);
  }
  .ggf26-more {
    display: inline-flex;
    margin-top: 0.7rem;
    color: var(--ggf-gold);
    font-size: 0.84rem;
    font-weight: 850;
    transition: color var(--ggf-ease);
  }
  .ggf26-more:hover {
    color: #fff;
  }

  .ggf26-phone {
    display: inline-flex;
    color: #fff;
    font-size: clamp(1.2rem, 1.5vw, 1.32rem);
    font-weight: 900;
    letter-spacing: -0.028em;
    line-height: 1.12;
    transition: color var(--ggf-ease);
  }
  .ggf26-phone:hover {
    color: var(--ggf-gold);
  }
  .ggf26-phone-note {
    margin-top: 0.3rem;
    color: #849488;
    font-size: 0.78rem;
    font-weight: 650;
  }
  .ggf26-contact-stack {
    display: grid;
    gap: 0.55rem;
    margin-top: 1.1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--ggf-line);
  }
  .ggf26-mail {
    color: #d8e3da;
    font-size: 0.86rem;
    font-weight: 650;
    overflow-wrap: anywhere;
    transition: color var(--ggf-ease);
  }
  .ggf26-mail:hover {
    color: var(--ggf-gold);
  }
  .ggf26-office {
    color: #a5b6a9;
    font-size: 0.84rem;
    font-weight: 600;
    line-height: 1.5;
  }
  .ggf26-directions {
    display: inline-flex;
    width: fit-content;
    color: var(--ggf-gold);
    font-size: 0.82rem;
    font-weight: 850;
    transition: color var(--ggf-ease);
  }
  .ggf26-directions:hover {
    color: #fff;
  }

  .ggf26-socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 1.2rem;
  }
  .ggf26-socials a {
    width: 2.2rem;
    height: 2.2rem;
    display: inline-grid;
    place-items: center;
    color: #c9d6cb;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 999px;
    transition:
      color var(--ggf-ease),
      background var(--ggf-ease),
      border-color var(--ggf-ease),
      transform var(--ggf-ease);
  }
  .ggf26-socials a svg {
    display: block;
  }
  .ggf26-socials a:hover {
    color: #fff;
    background: rgba(47, 139, 58, 0.4);
    border-color: rgba(70, 170, 81, 0.5);
    transform: translateY(-1px);
  }

  .ggf26-areas {
    display: grid;
    gap: 0.9rem;
    padding: 1.55rem 0 1.6rem;
    border-top: 1px solid var(--ggf-line);
  }
  #gg-footer-2026 .ggf26-areas-title {
    position: relative;
    width: fit-content;
    padding: 0 0 0.55rem;
    color: #f4f7f4;
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }
  #gg-footer-2026 .ggf26-areas-title::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    width: 2.4rem;
    height: 2px;
    border-radius: 99px;
    background: linear-gradient(90deg, var(--ggf-gold), rgba(242, 173, 47, 0.15));
  }
  .ggf26-area-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }
  .ggf26-area-list a {
    display: inline-flex;
    align-items: center;
    min-height: 1.95rem;
    padding: 0.28rem 0.7rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.035);
    color: #bccabc;
    font-size: 0.78rem;
    font-weight: 700;
    transition:
      background var(--ggf-ease),
      color var(--ggf-ease),
      border-color var(--ggf-ease);
  }
  .ggf26-area-list a:hover {
    background: rgba(47, 139, 58, 0.3);
    border-color: rgba(70, 170, 81, 0.38);
    color: #fff;
  }
  .ggf26-area-more {
    border-color: rgba(242, 173, 47, 0.38) !important;
    background: rgba(242, 173, 47, 0.1) !important;
    color: #ffd27a !important;
    font-weight: 850 !important;
  }
  .ggf26-area-more:hover {
    border-color: rgba(242, 173, 47, 0.55) !important;
    background: rgba(242, 173, 47, 0.18) !important;
    color: #fff !important;
  }

  .ggf26-bottom {
    min-height: 3.6rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.15rem;
    padding: 1.15rem 0 1.35rem;
    border-top: 1px solid var(--ggf-line);
    color: #7f9083;
    font-size: 0.76rem;
    font-weight: 650;
  }
  .ggf26-bottom-links {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: 0.4rem 1.1rem;
  }
  .ggf26-bottom a {
    color: #93a497;
    transition: color var(--ggf-ease);
  }
  .ggf26-bottom a:hover {
    color: #fff;
  }

  #gg-footer-2026 a:focus-visible {
    outline: 3px solid rgba(242, 173, 47, 0.55);
    outline-offset: 3px;
  }

  @media (max-width: 1060px) {
    .ggf26-main {
      grid-template-columns: 1.1fr 1fr 1fr;
    }
    .ggf26-contact {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0.35rem 2rem;
      align-items: start;
      padding-top: 1rem;
      border-top: 1px solid var(--ggf-line);
    }
    .ggf26-contact .ggf26-heading,
    .ggf26-contact .ggf26-phone,
    .ggf26-contact .ggf26-phone-note,
    .ggf26-contact .ggf26-contact-stack {
      grid-column: 1;
    }
    .ggf26-socials {
      grid-column: 2;
      grid-row: 2 / span 3;
      align-self: center;
      margin-top: 0;
    }
  }
  @media (max-width: 820px) {
    .ggf26-main {
      grid-template-columns: 1fr 1fr;
      gap: 1.85rem 2rem;
    }
    .ggf26-brand {
      grid-column: 1 / -1;
    }
    .ggf26-contact {
      grid-column: 1 / -1;
      grid-template-columns: 1fr;
    }
    .ggf26-socials {
      grid-column: auto;
      grid-row: auto;
      margin-top: 0.2rem;
    }
  }
  @media (max-width: 600px) {
    .ggf26-shell {
      width: calc(100% - 1.5rem);
    }
    .ggf26-main {
      grid-template-columns: 1fr;
      gap: 1.75rem;
      padding: 2.25rem 0 1.4rem;
    }
    .ggf26-brand,
    .ggf26-contact,
    .ggf26-nav {
      grid-column: auto;
    }
    .ggf26-contact {
      order: -1;
      padding-top: 0;
      border-top: 0;
    }
    .ggf26-brand-copy {
      max-width: none;
    }
    .ggf26-trust {
      gap: 0.25rem 0;
    }
    .ggf26-area-list a {
      min-height: 2.35rem;
    }
    .ggf26-areas {
      padding: 1.35rem 0 1.4rem;
    }
    .ggf26-bottom {
      min-height: 0;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.8rem;
      padding: 1.2rem 0 1.55rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    #gg-footer-2026 * {
      transition-duration: 0.01ms !important;
    }
  }
</style>
