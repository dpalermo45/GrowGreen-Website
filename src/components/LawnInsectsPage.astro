<script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<script>
  const root = document.querySelector<HTMLElement>("[data-insects-page]");
  if (root) {
    const notes = root.querySelector<HTMLTextAreaElement>('textarea[name="notes"]');
    const buttons = root.querySelectorAll<HTMLButtonElement>("[data-pick-concern]");
    const SERVICE_PREFIX = "Service requested: Lawn Insect Control";

    function ensureServiceNote() {
      if (!notes) return;
      const lines = (notes.value || "")
        .split("\n")
        .map((line) => line.trim())
        .filter(Boolean)
        .filter((line) => !line.startsWith("Service requested:"));
      lines.unshift(SERVICE_PREFIX);
      notes.value = lines.join("\n");
    }

    function applyConcern(value: string) {
      if (!notes) return;
      const prefix = "Closest description: ";
      const lines = (notes.value || "")
        .split("\n")
        .map((l) => l.trim())
        .filter(Boolean)
        .filter((l) => !l.startsWith(prefix) && !l.startsWith("Service requested:"));
      lines.unshift(`${prefix}${value}`);
      lines.unshift(SERVICE_PREFIX);
      notes.value = lines.join("\n");
      buttons.forEach((b) => b.classList.toggle("is-active", b.dataset.pickConcern === value));
    }

    ensureServiceNote();
    notes?.addEventListener("blur", ensureServiceNote);

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        const value = button.dataset.pickConcern || "";
        if (!value) return;
        applyConcern(value);
        const quote = document.getElementById("insects-quote");
        quote?.scrollIntoView({ behavior: "smooth", block: "start" });
        window.setTimeout(() => notes?.focus({ preventScroll: true }), 500);
      });
    });
  }
</script>
