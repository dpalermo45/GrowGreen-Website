    function cookieGet(name) {
      var match = document.cookie.match(
        new RegExp("(?:^|; )" + name.replace(/[.*+?^${}()|[\]\\]/g, "\\$&") + "=([^;]*)"),
      );
      return match ? decodeURIComponent(match[1]) : "";
    }

    function fillAttribution() {
      var params = new URLSearchParams(window.location.search);
      var keys = [
        "utm_source",
        "utm_medium",
        "utm_campaign",
        "utm_content",
        "utm_term",
        "fbclid",
        "gclid",
      ];
      var pageField = form.querySelector('[data-attribution="page_url"]');
      var fbpField = form.querySelector('[data-attribution="fbp"]');
      var fbcField = form.querySelector('[data-attribution="fbc"]');

      if (pageField) {
        pageField.value = window.location.href.slice(0, 2000);
      }

      keys.forEach(function (key) {
        var field = form.querySelector('[data-attribution="' + key + '"]');
        var value = params.get(key);
        if (field && value) field.value = cleanValue(value, 500);
      });

      if (fbpField && !fbpField.value) {
        fbpField.value = cleanValue(cookieGet("_fbp"), 500);
      }
      if (fbcField && !fbcField.value) {
        fbcField.value = cleanValue(cookieGet("_fbc"), 500);
      }
    }

    function buildNotes() {
      var lines = [
        OFFER_ACTIVE
          ? "Landing page: Facebook - November 50% Off First Lawn Treatment (Up to $75)"
          : "Landing page: Facebook estimate request",
        "Service: " + SERVICE,
      ];
      if (PROMOTION) {
        lines.push("Promotion: " + PROMOTION);
      }

      if (document.referrer) {
        lines.push("Referrer: " + cleanValue(document.referrer, 1000));
      }

      return lines.join("\n");
    }

    function normalizeFormValues() {
      var textInputs = form.querySelectorAll(
        'input[type="text"], input[type="email"], input[type="tel"]',
      );
      var i;

      for (i = 0; i < textInputs.length; i += 1) {
        if (textInputs[i].name !== "website") {
          textInputs[i].value = textInputs[i].value.trim();
        }
      }

      if (zipInput) {
        zipInput.value = zipInput.value.replace(/\D/g, "").slice(0, 5);
      }
      if (phoneInput) {
        phoneInput.value = formatPhone(phoneInput.value);
      }
    }

    function validatePhone() {
      if (!phoneInput) return true;
      var valid = digitsOnly(phoneInput.value).length === 10;
      phoneInput.setCustomValidity(valid ? "" : "Enter a 10-digit phone number.");
      return valid;
    }

    function buildPayload() {
      var pageUrl = cleanValue(window.location.href, 2000);
      var smsChecked = !!(smsConsent && smsConsent.checked);
      var disclosure =
        (root.dataset && root.dataset.smsDisclosure) || SMS_DISCLOSURE || "";
      return {
        name: cleanValue(fieldByName("name").value, 120),
        phone: digitsOnly(fieldByName("phone").value),
        email: cleanValue(fieldByName("email").value, 160),
        address: cleanValue(fieldByName("address").value, 160),
        city: cleanValue(fieldByName("city").value, 80),
        zip: cleanValue(fieldByName("zip").value, 5),
        state: "LA",
        source: LEAD_SOURCE,
        lead_source: LEAD_SOURCE,
        services_interest: SERVICE,
        promotion_code: PROMOTION,
        page_url: pageUrl,
        event_source_url: pageUrl,
        submitted_at: new Date().toISOString(),
        sms_opt_in_status: smsChecked ? "Yes" : "No",
        promotional_sms_opt_in: smsChecked,
        promotional_sms_disclosure: disclosure,
        notes: buildNotes(),
        utm_source: cleanValue(fieldByName("utm_source").value, 500),
        utm_medium: cleanValue(fieldByName("utm_medium").value, 500),
        utm_campaign: cleanValue(fieldByName("utm_campaign").value, 500),
        utm_content: cleanValue(fieldByName("utm_content").value, 500),
        utm_term: cleanValue(fieldByName("utm_term").value, 500),
        fbclid: cleanValue(fieldByName("fbclid").value, 500),
        gclid: cleanValue(fieldByName("gclid").value, 500),
        fbp: cleanValue(fieldByName("fbp").value, 500),
        fbc: cleanValue(fieldByName("fbc").value, 500),
        browser_event_id: leadKey,
        idempotency_key: leadKey,
        website: cleanValue(fieldByName("website") && fieldByName("website").value, 120),
      };
    }

    function applyServerErrors(data) {
      var errors = data && (data.field_errors || data.errors);
      var firstField = null;

      if (!errors || typeof errors !== "object" || Array.isArray(errors)) {
        return false;
      }

      Object.keys(errors).forEach(function (name) {
        var aliases = {
          full_name: "name",
          postal_code: "zip",
          zipcode: "zip",
        };
        var resolvedName = aliases[name] || name;

        if (setFieldError(name, errors[name]) && !firstField) {
          firstField = fieldByName(resolvedName);
        }
      });

      if (firstField) {
        firstField.focus();
        return true;
      }
      return false;
    }

    function hasBridgeError(data) {
      if (!data || typeof data !== "object") return false;

      function nonempty(value) {
        if (Array.isArray(value)) return value.length > 0;
        if (value && typeof value === "object") {
          return Object.keys(value).length > 0;
        }
        return Boolean(value);
      }

      return (
        data.success === false ||
        data.ok === false ||
        nonempty(data.error) ||
        nonempty(data.errors) ||
        nonempty(data.field_errors) ||
        Number(data.status) >= 400 ||
        (data.code &&
          data.code !== "success" &&
          data.code !== "ok" &&
          !data.success &&
          !data.ok) ||
        (data.data && hasBridgeError(data.data))
      );
    }

