      }

      addressInput.setAttribute("aria-activedescendant", options[activeAddressIndex].id);
      options[activeAddressIndex].scrollIntoView({ block: "nearest" });
    }

    function chooseAddress(feature) {
      if (!feature || !addressInput) return;

      var cityPart = contextPart(feature, "place");
      var zipPart = contextPart(feature, "postcode");
      var regionPart = contextPart(feature, "region");
      var street = feature.address ? feature.address + " " + feature.text : feature.text;

      addressRequestSeq++;
      if (addressController) addressController.abort();

      var cityField = fieldByName("city");
      var zipField = fieldByName("zip");

      addressInput.value = cleanValue(street, 160);

      if (cityPart && cityPart.text && cityField) {
        cityField.value = cleanValue(cityPart.text, 80);
      }
      if (zipPart && zipPart.text && zipField) {
        zipField.value = String(zipPart.text).replace(/\D/g, "").slice(0, 5);
      }

      clearFieldError("address");
      clearFieldError("city");
      clearFieldError("zip");
      hideAddressResults();

      if (
        regionPart &&
        regionPart.short_code &&
        regionPart.short_code.toLowerCase() !== "us-la"
      ) {
        showStatus(
          "This address appears to be outside Louisiana. Please review the service address.",
        );
        return;
      }

      if (cityField && !cityField.value) cityField.focus();
    }

    function renderAddressResults(features) {
      if (!addressResults || !addressInput) return;

      addressResults.innerHTML = "";
      activeAddressIndex = -1;

      if (!features || !features.length) {
        hideAddressResults();
        return;
      }

      for (var i = 0; i < features.length; i += 1) {
        (function (feature, index) {
          var option = document.createElement("button");
          option.type = "button";
          option.className = "gg-address-option";
          option.id = "gg-address-option-" + index;
          option.setAttribute("role", "option");
          option.setAttribute("aria-selected", "false");
          option.textContent =
            feature.place_name || feature.text || "Address suggestion";

          option.addEventListener("mousedown", function (event) {
            event.preventDefault();
          });
          option.addEventListener("click", function () {
            chooseAddress(feature);
          });
          option.addEventListener("mouseenter", function () {
            setActiveAddressOption(index);
          });

          addressResults.appendChild(option);
        })(features[i], i);
      }

      addressResults.hidden = false;
      addressInput.setAttribute("aria-expanded", "true");
    }

    function searchAddress(query) {
      if (!addressInput || !addressResults || !MAPBOX_TOKEN) return;

      if (addressController) addressController.abort();
      var requestSeq = ++addressRequestSeq;
      addressController =
        typeof AbortController === "function" ? new AbortController() : null;

      var endpoint =
        "https://api.mapbox.com/geocoding/v5/mapbox.places/" +
        encodeURIComponent(query) +
        ".json?autocomplete=true&types=address&country=us&limit=5&language=en&proximity=-91.05,30.35&bbox=-92.25,29.40,-89.35,31.65&access_token=" +
        encodeURIComponent(MAPBOX_TOKEN);

      fetch(endpoint, {
        signal: addressController ? addressController.signal : undefined,
      })
        .then(function (response) {
          if (!response.ok) {
            throw new Error("Address search unavailable");
          }
          return response.json();
        })
        .then(function (data) {
          var features =
            data && Array.isArray(data.features) ? data.features : [];

          if (
            requestSeq === addressRequestSeq &&
            addressInput &&
            cleanValue(addressInput.value, 160).length >= 4
          ) {
            renderAddressResults(features);
          }
        })
        .catch(function (error) {
          if (
            requestSeq === addressRequestSeq &&
            (!error || error.name !== "AbortError")
          ) {
            hideAddressResults();
          }
        });
    }

    function scrollToForm() {
      var reduceMotion =
        window.matchMedia &&
        window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      formCard.scrollIntoView({
        behavior: reduceMotion ? "auto" : "smooth",
        block: "start",
      });

      window.setTimeout(
        function () {
          var firstField = root.querySelector("#gg-address");
          if (firstField) firstField.focus({ preventScroll: true });
        },
        reduceMotion ? 0 : 450,
      );
    }

    fillAttribution();

    if (addressInput && addressResults) {
      addressInput.addEventListener("input", function () {
        window.clearTimeout(addressTimer);
        clearFieldError("address");
        addressRequestSeq += 1;
        if (addressController) addressController.abort();
        hideAddressResults();

        var query = cleanValue(addressInput.value, 160);
        if (query.length < 4) {
          hideAddressResults();
          return;
        }

        addressTimer = window.setTimeout(function () {
          searchAddress(query + " Louisiana");
        }, 280);
      });

      addressInput.addEventListener("keydown", function (event) {
        var options = addressResults.querySelectorAll(".gg-address-option");
        var isOpen = !addressResults.hidden && options.length > 0;

        if (event.key === "Escape") {
          hideAddressResults();
          return;
        }
        if (!isOpen) return;

        if (event.key === "ArrowDown") {
          event.preventDefault();
          setActiveAddressOption(activeAddressIndex + 1);
        } else if (event.key === "ArrowUp") {
          event.preventDefault();
          setActiveAddressOption(activeAddressIndex - 1);
        } else if (event.key === "Enter" && activeAddressIndex >= 0) {
          event.preventDefault();
          options[activeAddressIndex].click();
        }
      });

      addressInput.addEventListener("blur", function () {
        window.setTimeout(function () {
          if (!addressResults.contains(document.activeElement)) {
            hideAddressResults();
          }
        }, 120);
      });

      document.addEventListener("click", function (event) {
        if (
          event.target !== addressInput &&
          !addressResults.contains(event.target)
        ) {
          hideAddressResults();
        }
      });
    }

    if (phoneInput) {
      phoneInput.addEventListener("input", function () {
        phoneInput.setCustomValidity("");
        clearFieldError("phone");
      });
      phoneInput.addEventListener("blur", function () {
        phoneInput.value = formatPhone(phoneInput.value);
        validatePhone();
      });
    }

    if (zipInput) {
      zipInput.addEventListener("input", function () {
        zipInput.value = zipInput.value.replace(/\D/g, "").slice(0, 5);
        clearFieldError("zip");
      });
    }

    form.addEventListener("input", function (event) {
      if (event.target && event.target.name) {
        clearFieldError(event.target.name);
      }
    });

    form.addEventListener("submit", function (event) {
      event.preventDefault();
      if (submitting) return;

      clearAllErrors();
      hideAddressResults();
      normalizeFormValues();
      validatePhone();

      var honeypot = fieldByName("website");
      if (honeypot && honeypot.value) return;

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      setSubmitting(true);

      var controller =
        typeof AbortController === "function" ? new AbortController() : null;

      var timeoutId = window.setTimeout(function () {
        if (controller) controller.abort();
      }, 20000);

      fetch(CRM_ENDPOINT, {
        method: "POST",
        credentials: "same-origin",
        headers: {
          "Content-Type": "application/json",
          Accept: "application/json",
        },
        body: JSON.stringify(buildPayload()),
        signal: controller ? controller.signal : undefined,
      })
        .then(function (response) {
          return response
            .json()
            .catch(function () {
              return null;
            })
            .then(function (data) {
              return { response: response, data: data };
            });
        })
        .then(function (result) {
          if (
            !result.response.ok ||
            !result.data ||
            typeof result.data !== "object" ||
            Array.isArray(result.data) ||
            Object.keys(result.data).length === 0 ||
            hasBridgeError(result.data) ||
            result.data.customer_id == null ||
            result.data.customer_id === ""
          ) {
            var error = new Error(responseMessage(result.data, result.response));
            error.serverData = result.data;
            throw error;
          }

          form.style.display = "none";
          successBox.classList.add("is-visible");
          root.classList.add("gg-submitted");
          successBox.focus();
          safeSessionRemove("gg_facebook_november_2026_estimate_key");

          if (typeof window.ggwcTrack === "function") {
            try {
              window.ggwcTrack("ggwc_lead_accepted", {
                customer_id: result.data.customer_id,
                mocked: !!result.data.mocked,
                content_name: "Facebook November 50% Off First Treatment Estimate",
              });
            } catch (trackError) {
              /* Tracking must never block a successful submission. */
            }
          }

          /* Meta Pixel Lead only after confirmed non-mock CRM acceptance. */
          if (!result.data.mocked && typeof window.fbq === "function") {
            try {
              window.fbq(
                "track",
                "Lead",
                {
                  content_name: "Facebook November 50% Off First Treatment Estimate",
                },
                { eventID: leadKey },
              );
            } catch (pixelError) {
              /* Tracking must never block a successful submission. */
            }
          }

          window.setTimeout(function () {
            window.location.assign(THANK_YOU_URL);
          }, 1200);
        })
        .catch(function (error) {
          var hasFieldErrors = applyServerErrors(error.serverData);
          var message =
            error && error.name === "AbortError"
              ? "We couldn’t confirm receipt in time. Your details are still here. Retry once, or call (225) 461-3199 to check your request."
              : error && error.message
                ? error.message
                : "A connection error stopped the request. Please try again, or call (225) 461-3199.";

          showStatus(
            hasFieldErrors
              ? "Please correct the highlighted information and try again."
              : message,
          );
          setSubmitting(false);
        })
        .then(function () {
          window.clearTimeout(timeoutId);
        });
    });

    submitButton.disabled = false;
    if (submitLabel) submitLabel.textContent = defaultButtonText;

    var scrollButtons = root.querySelectorAll("[data-scroll-to-estimate]");
    for (var i = 0; i < scrollButtons.length; i += 1) {
      scrollButtons[i].addEventListener("click", scrollToForm);
    }

    if (
      window.location.hash === "#gg-estimate-form" ||
      window.location.hash === "#gg-form"
    ) {
      window.setTimeout(scrollToForm, 100);
    }

    if ("IntersectionObserver" in window && formCard) {
      var observer = new IntersectionObserver(
        function (entries) {
          root.classList.toggle("gg-form-in-view", entries[0].isIntersecting);
        },
        { threshold: 0.12 },
      );
      observer.observe(formCard);
    }
  })();
</script>
