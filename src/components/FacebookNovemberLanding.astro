    var addressTimer = null;
    var addressController = null;
    var activeAddressIndex = -1;

    if (!form || !submitButton || !statusBox || !successBox) return;

    function safeSessionGet(key) {
      try {
        return window.sessionStorage.getItem(key);
      } catch (error) {
        return null;
      }
    }

    function safeSessionSet(key, value) {
      try {
        window.sessionStorage.setItem(key, value);
      } catch (error) {
        /* Storage can be blocked; submission still works. */
      }
    }

    function safeSessionRemove(key) {
      try {
        window.sessionStorage.removeItem(key);
      } catch (error) {
        /* Storage can be blocked; submission still works. */
      }
    }

    function getLeadKey() {
      var storageKey = "gg_facebook_november_2026_estimate_key";
      var existing = safeSessionGet(storageKey);
      if (existing) return existing;

      var generated =
        window.crypto && typeof window.crypto.randomUUID === "function"
          ? window.crypto.randomUUID()
          : "fb-nov-lp-" + Date.now() + "-" + Math.random().toString(36).slice(2, 10);

      safeSessionSet(storageKey, generated);
      return generated;
    }

    function cleanValue(value, maxLength) {
      return String(value || "")
        .replace(/[\r\n]+/g, " ")
        .trim()
        .slice(0, maxLength || 500);
    }

    function digitsOnly(value) {
      var digits = String(value || "").replace(/\D/g, "");
      if (digits.length === 11 && digits.charAt(0) === "1") {
        digits = digits.slice(1);
      }
      return digits;
    }

    function formatPhone(value) {
      var digits = digitsOnly(value);
      if (digits.length < 4) return digits;
      if (digits.length < 7) {
        return "(" + digits.slice(0, 3) + ") " + digits.slice(3);
      }
      return "(" + digits.slice(0, 3) + ") " + digits.slice(3, 6) + "-" + digits.slice(6);
    }

    function fieldByName(name) {
      return form.querySelector('[name="' + name + '"]');
    }

    function clearFieldError(name) {
      var field = fieldByName(name);
      var error = form.querySelector('[data-error-for="' + name + '"]');
      if (field) field.removeAttribute("aria-invalid");
      if (error) error.textContent = "";
    }

    function setFieldError(name, message) {
      var aliases = {
        full_name: "name",
        postal_code: "zip",
        zipcode: "zip",
      };
      var resolvedName = aliases[name] || name;
      var allowedFields = ["name", "phone", "email", "address", "city", "zip"];
      if (allowedFields.indexOf(resolvedName) === -1) return false;

      var field = fieldByName(resolvedName);
      var error = form.querySelector('[data-error-for="' + resolvedName + '"]');
      if (!field || !error) return false;

      field.setAttribute("aria-invalid", "true");
      error.textContent = cleanValue(Array.isArray(message) ? message[0] : message, 250);
      return true;
