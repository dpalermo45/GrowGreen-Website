      if (response.status === 429) {
        return "Please wait a moment before trying again, or call (225) 461-3199.";
      }
      if (data && typeof data.message === "string") {
        return cleanValue(data.message, 350);
      }
      if (data && typeof data.detail === "string") {
        return cleanValue(data.detail, 350);
      }
      return "We couldn’t send the request. Please check the form and try again, or call (225) 461-3199.";
