      for (var i = 0; i < context.length; i += 1) {
        if (context[i].id && context[i].id.indexOf(prefix + ".") === 0) {
          return context[i];
        }
      }
      return null;
    }

    function hideAddressResults() {
      if (!addressResults || !addressInput) return;
      addressResults.hidden = true;
