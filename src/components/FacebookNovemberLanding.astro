---
import { site } from "../data/site";
import type { CampaignOffer } from "../data/campaigns";
import { coverageShortPhrase } from "../data/service-areas";
import { PROMOTIONAL_SMS_DISCLOSURE } from "../lib/leads/promotionalSms";

interface Props {
  campaign: CampaignOffer;
  offerActive: boolean;
}

const { campaign, offerActive } = Astro.props;

const mapToken = import.meta.env.PUBLIC_MAPBOX_TOKEN || "";
const leadSource =
  campaign.leadSourceHint ||
  "Facebook Ad - November 50% Off First Treatment (Up to $75)";
const promotion =
  "November Facebook Promo - 50% Off First Lawn Treatment, Maximum $75 Discount";
const thankYouPath = campaign.thankYouPath || "/thank-you/";
const serviceLabel = "Lawn Fertilization & Weed Control";
const smsDisclosure = PROMOTIONAL_SMS_DISCLOSURE;
---

<section
  id="gg-fb-estimate"
  aria-label="Grow Green November lawn treatment offer"
  data-fb-november-landing
  data-lead-source={leadSource}
  data-source={leadSource}
  data-promotion={offerActive ? promotion : ""}
  data-service={serviceLabel}
  data-thank-you={thankYouPath}
  data-mapbox={mapToken}
  data-offer-active={offerActive ? "true" : "false"}
  data-sms-disclosure={smsDisclosure}
>
  <div class="gg-topline">
    {
      offerActive ? (
        <>
          <span>November special</span>
          <span class="gg-topline__dot" aria-hidden="true" />
          <strong>50% off your first lawn treatment</strong>
          <span class="gg-topline__dot" aria-hidden="true" />
          <span>Up to $75 off</span>
        </>
      ) : (
        <>
          <span>Free estimate</span>
          <span class="gg-topline__dot" aria-hidden="true" />
          <strong>Lawn fertilization &amp; weed control</strong>
          <span class="gg-topline__dot" aria-hidden="true" />
          <span>Plans start at ${site.startingPrice.amount}/{site.startingPrice.period}</span>
        </>
      )
    }
  </div>

  <header class="gg-header">
    <div class="gg-shell gg-header__inner">
      <a href="/" class="gg-logo-link" aria-label={`${site.name} home`}>
        <img
          class="gg-logo"
          src="/images/brand/logo-128.webp"
          srcset="/images/brand/logo-64.webp 64w, /images/brand/logo-128.webp 128w, /images/brand/logo-192.webp 192w"
          sizes="52px"
          alt=""
          width="52"
          height="52"
          fetchpriority="high"
          decoding="async"
        />
        <span>
          <strong>Grow Green</strong>
          <small>Weed Control</small>
        </span>
      </a>
      <div class="gg-header-right">
        <span>Local · Family-owned · Firefighter-owned</span>
        <a href={`tel:${site.phoneTel}`}>{site.phone}</a>
      </div>
    </div>
  </header>

  <div class="gg-hero">
    <div class="gg-hero__media" aria-hidden="true"></div>
    <div class="gg-hero__veil" aria-hidden="true"></div>
    <div class="gg-shell gg-hero-grid">
      <div class="gg-hero-copy">
        <span class="gg-kicker">South Louisiana lawns · Local lawn experts</span>
        <p class="gg-brand">Grow Green Weed Control</p>
        <h1>
          Less weeds.
          <br />
          <em>More lawn to love.</em>
        </h1>
        <p class="gg-hero-lead">
          Give your lawn a plan for every season. Get a free estimate for professional weed control
          and fertilization from your local, firefighter-owned team.
        </p>

        {
          offerActive ? (
            <div class="gg-offer">
              <div class="gg-offer-number">
                50<small>% OFF</small>
              </div>
              <div class="gg-offer-text">
                Your first lawn treatment
                <span>November special · Save up to $75</span>
              </div>
              <img
                class="gg-offer-mascot"
                src="/images/mascot/backpack-sprayer.png"
                alt=""
                width="88"
                height="106"
                decoding="async"
              />
            </div>
          ) : (
            <div class="gg-offer gg-offer-expired">
              <div class="gg-offer-text">
                This November special has ended.
                <span>You can still request a free estimate for your lawn.</span>
              </div>
            </div>
          )
        }

        <ul class="gg-hero-points">
          <li>Free, no-obligation estimate</li>
          <li>Local firefighter-owned team</li>
          <li>Plans start at ${site.startingPrice.amount}/{site.startingPrice.period}</li>
        </ul>

        <div class="gg-hero-actions">
          <a class="gg-hero-cta" href="#gg-estimate-form-card">
            {offerActive ? "Claim the November offer" : "Request my estimate"}
          </a>
          <a class="gg-hero-call" href={`tel:${site.phoneTel}`}>Call {site.phone}</a>
        </div>
      </div>

      <div class="gg-form-card" id="gg-estimate-form-card">
          <p class="gg-form-eyebrow">
            {offerActive ? "Your November offer starts here" : "Request your free estimate"}
          </p>
          <h2>Let’s price your lawn.</h2>
          <p class="gg-form-intro">
            Tell us where to look and how to reach you. We’ll prepare your custom estimate, usually
            within one business day.
          </p>

          {
            offerActive ? (
              <div class="gg-offer-banner">
                <strong>50% off your first lawn treatment — up to $75 off.</strong>
                <br />
                Requesting an estimate is free. You decide before any service begins.
              </div>
            ) : null
          }

          <form
            id="gg-estimate-form"
            name="growgreen-facebook-estimate"
            method="post"
            autocomplete="on"
            data-estimate-form
          >
            <input type="hidden" name="source" value={leadSource} />
            <input type="hidden" name="lead_source" value={leadSource} />
            <input type="hidden" name="service" value={serviceLabel} />
            <input type="hidden" name="promotion" value={offerActive ? promotion : ""} />
            <input type="hidden" name="page_url" data-attribution="page_url" value="" />
            <input type="hidden" name="utm_source" data-attribution="utm_source" value="" />
            <input type="hidden" name="utm_medium" data-attribution="utm_medium" value="" />
            <input type="hidden" name="utm_campaign" data-attribution="utm_campaign" value="" />
            <input type="hidden" name="utm_content" data-attribution="utm_content" value="" />
            <input type="hidden" name="utm_term" data-attribution="utm_term" value="" />
            <input type="hidden" name="fbclid" data-attribution="fbclid" value="" />
            <input type="hidden" name="gclid" data-attribution="gclid" value="" />
            <input type="hidden" name="fbp" data-attribution="fbp" value="" />
            <input type="hidden" name="fbc" data-attribution="fbc" value="" />
            <input type="hidden" name="state" value="LA" />

            <div class="gg-honeypot" aria-hidden="true">
              <label for="gg-company-website">Leave this field blank</label>
              <input
                id="gg-company-website"
                type="text"
                name="website"
                tabindex="-1"
                autocomplete="off"
              />
            </div>

            <div class="gg-form-section"><span>1</span> Where is your lawn?</div>
            <div class="gg-fields">
              <div class="gg-field gg-field-full gg-address-field">
                <label for="gg-address">
                  Street address<span class="gg-required" aria-hidden="true">*</span>
                </label>
                <input
                  id="gg-address"
                  name="address"
                  type="text"
                  placeholder="1234 Oak Street"
                  required
                  minlength="5"
                  maxlength="160"
                  autocomplete="off"
                  autocorrect="off"
                  spellcheck="false"
                  autocapitalize="words"
                  enterkeyhint="next"
                  role="combobox"
                  aria-autocomplete="list"
                  aria-controls="gg-address-results"
                  aria-expanded="false"
                  aria-haspopup="listbox"
                />
                <div
                  class="gg-address-results"
                  id="gg-address-results"
                  role="listbox"
                  aria-label="Address suggestions"
                  hidden
                >
                </div>
                <p class="gg-address-hint">
                  Choose a suggestion, or enter your address, city and ZIP manually.
                </p>
                <div class="gg-field-error" data-error-for="address" aria-live="polite"></div>
              </div>
              <div class="gg-field">
                <label for="gg-city">
                  City<span class="gg-required" aria-hidden="true">*</span>
                </label>
                <input
                  id="gg-city"
                  name="city"
                  type="text"
                  placeholder="Prairieville"
                  required
                  minlength="2"
                  maxlength="80"
                  autocomplete="address-level2"
                  autocapitalize="words"
                  enterkeyhint="next"
                />
                <div class="gg-field-error" data-error-for="city" aria-live="polite"></div>
              </div>
              <div class="gg-field">
                <label for="gg-zip">
                  ZIP code<span class="gg-required" aria-hidden="true">*</span>
                </label>
                <input
                  id="gg-zip"
                  name="zip"
                  type="text"
                  placeholder="70769"
                  required
                  inputmode="numeric"
                  pattern="[0-9]{5}"
                  maxlength="5"
                  autocomplete="postal-code"
                  enterkeyhint="next"
                  title="Enter a 5-digit ZIP code"
                />
                <div class="gg-field-error" data-error-for="zip" aria-live="polite"></div>
              </div>
            </div>

            <div class="gg-form-section"><span>2</span> Where should we send your estimate?</div>
            <div class="gg-fields">
              <div class="gg-field gg-field-full">
                <label for="gg-name">
                  Full name<span class="gg-required" aria-hidden="true">*</span>
                </label>
                <input
                  id="gg-name"
                  name="name"
                  type="text"
                  placeholder="First and last name"
                  required
                  minlength="2"
                  maxlength="120"
                  autocomplete="name"
                  autocapitalize="words"
                  enterkeyhint="next"
                />
                <div class="gg-field-error" data-error-for="name" aria-live="polite"></div>
              </div>
              <div class="gg-field">
                <label for="gg-phone">
                  Phone<span class="gg-required" aria-hidden="true">*</span>
                </label>
                <input
                  id="gg-phone"
                  name="phone"
                  type="tel"
                  placeholder="(225) 555-1234"
                  required
                  inputmode="tel"
                  autocomplete="tel"
                  enterkeyhint="next"
                  title="Enter a 10-digit phone number"
                />
                <div class="gg-field-error" data-error-for="phone" aria-live="polite"></div>
              </div>
              <div class="gg-field">
                <label for="gg-email">
                  Email<span class="gg-required" aria-hidden="true">*</span>
                </label>
                <input
                  id="gg-email"
                  name="email"
                  type="email"
                  placeholder="you@email.com"
                  required
                  maxlength="160"
                  autocomplete="email"
                  inputmode="email"
                  enterkeyhint="done"
                />
                <div class="gg-field-error" data-error-for="email" aria-live="polite"></div>
              </div>
            </div>

            <label class="gg-consent" for="gg-sms-consent">
              <input id="gg-sms-consent" name="sms_consent" type="checkbox" value="yes" />
              <span>{smsDisclosure}</span>
            </label>

            <button class="gg-submit" id="gg-estimate-submit" type="submit" disabled>
              <span data-button-label>Loading secure form…</span>
              <span class="gg-button-arrow" aria-hidden="true">→</span>
            </button>

            <p class="gg-submit-note">
              <strong>Usually sent within 1 business day.</strong>
              {
                offerActive
                  ? "50% off your first lawn treatment, up to $75 off."
                  : site.startingPrice.short
              }
            </p>
            <p class="gg-privacy-note">
              By submitting, you agree we may call or email you about this estimate. Your information
              is used to respond to this request.
            </p>
            <div class="gg-form-status" id="gg-form-status" role="alert" aria-live="assertive"></div>
          </form>

          <div
            class="gg-success"
            id="gg-estimate-success"
            tabindex="-1"
            role="status"
            aria-live="polite"
          >
            <div class="gg-success-mark" aria-hidden="true">✓</div>
            <h3>Thank you!</h3>
            <p>
              Your request has been accepted by our website. We’ll be in touch about your lawn
              estimate.
              {
                offerActive
                  ? " November offer: 50% off your first lawn treatment, up to $75 off."
                  : ""
              }
            </p>
          </div>

          <noscript>
            <p class="gg-form-status is-error" style="display:block">
              Please enable JavaScript to send this form, or call{" "}
              <a href={`tel:${site.phoneTel}`}>{site.phone}</a> for your free estimate.
            </p>
          </noscript>
        </div>
      </div>
  </div>

  <div class="gg-trust">
    <div class="gg-shell gg-trust-grid">
      <div>
        <strong>Firefighter-owned</strong>
        <span>Local people. Personal accountability.</span>
      </div>
      <div>
        <strong>Seasonal lawn program</strong>
        <span>A plan that follows the seasons.</span>
      </div>
      <div>
        <strong>Clear written estimate</strong>
        <span>Know the price before you decide.</span>
      </div>
      <div>
        <strong>Clear service updates</strong>
        <span>Know what happened on your lawn.</span>
      </div>
    </div>
  </div>

  <div class="gg-lawn-band">
    <div class="gg-shell">
      <figure class="gg-lawn-band__photo">
        <img
          src="/images/campaigns/facebook-nov/lawn-sign.jpg"
          alt="Healthy lawn with a Grow Green Weed Control yard sign"
          width="980"
          height="551"
          loading="lazy"
          decoding="async"
        />
        <figcaption>A real Grow Green lawn. A plan built for yours.</figcaption>
      </figure>
    </div>
  </div>

  <div class="gg-section gg-white">
    <div class="gg-shell">
      <div class="gg-section-head gg-section-head--stack">
        <span class="gg-section-label">More than a one-time spray</span>
        <h2>The right care. At the right time of year.</h2>
        <p>
          Louisiana lawns need more than the same treatment on repeat. Our program changes with the
          season, your grass type and what’s growing in your yard.
        </p>
      </div>
      <div class="gg-program-grid">
        <article class="gg-program-card">
          <span class="gg-card-number">01 / PREVENT</span>
          <h3>Get ahead of weeds.</h3>
          <p>
            Seasonal pre-emergent treatments help prevent many weeds before they become a bigger
            problem.
          </p>
        </article>
        <article class="gg-program-card">
          <span class="gg-card-number">02 / CONTROL</span>
          <h3>Treat what’s there.</h3>
          <p>
            Targeted weed control addresses active weeds with treatments suited to your lawn and the
            season.
          </p>
        </article>
        <article class="gg-program-card">
          <span class="gg-card-number">03 / NOURISH</span>
          <h3>Build a stronger lawn.</h3>
          <p>
            Fertilization timed to the growing season supports your lawn as part of a consistent,
            year-round program.
          </p>
        </article>
      </div>
      <div class="gg-season-note">
        <img
          src="/images/mascot/backpack-sprayer.png"
          alt="Grow Green backpack sprayer mascot"
          loading="lazy"
          decoding="async"
          width="83"
          height="110"
        />
        <div>
          <strong>Why start in the fall?</strong>
          <p>
            Weed prevention is part of a year-round plan. Starting now lets us review your lawn and
            plan the next steps through the cooler months and into spring. We’ll explain what your
            lawn needs in your estimate.
          </p>
        </div>
      </div>
    </div>
  </div>

  <div class="gg-section">
    <div class="gg-shell gg-local-grid">
      <div class="gg-local-media">
        <figure class="gg-local-media__main">
          <img
            src="/images/campaigns/facebook-nov/community.jpeg"
            alt="Grow Green with local firefighters at a community event"
            loading="lazy"
            decoding="async"
            width="768"
            height="1024"
          />
          <figcaption>Rooted here. Proud to be part of our community.</figcaption>
        </figure>
        <figure class="gg-local-media__truck">
          <img
            src="/images/hero/truck-and-trailer-960.webp"
            srcset="/images/hero/truck-and-trailer-640.webp 640w, /images/hero/truck-and-trailer-960.webp 960w, /images/hero/truck-and-trailer-1280.webp 1280w"
            sizes="(max-width: 900px) 100vw, 28vw"
            alt="Grow Green Weed Control truck and trailer"
            width="960"
            height="720"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>
      <div class="gg-local-copy">
        <span class="gg-section-label">Your neighbors in lawn care</span>
        <h2>Local roots. Care you can count on.</h2>
        <p>
          Grow Green is a family-owned, firefighter-owned lawn treatment company serving the Greater
          Baton Rouge area. We believe good service starts with showing up, doing the work and
          keeping you informed.
        </p>
        <ul class="gg-local-list">
          <li>We specialize in fertilization and weed control.</li>
          <li>Get a clear price before you decide.</li>
          <li>Stay informed with service details and photos.</li>
          <li>Spread program costs with level monthly billing.</li>
        </ul>
        <p class="gg-service-area">
          <strong>Serving</strong> Prairieville, Gonzales, Baton Rouge, Denham Springs, Walker,
          Central, Zachary and surrounding communities. We’ll confirm availability for your address.
        </p>
        <button class="gg-scroll-button gg-local-cta" type="button" data-scroll-to-estimate>
          {offerActive ? "Claim my November offer" : "Get my free estimate"}
          <span aria-hidden="true">→</span>
        </button>
      </div>
    </div>
  </div>

  <div class="gg-section gg-white">
    <div class="gg-shell">
      <div class="gg-section-head gg-section-head--center">
        <div>
          <span class="gg-section-label">Simple from the start</span>
          <h2>A few details. A clear next step.</h2>
        </div>
      </div>
      <div class="gg-process">
        <article>
          <span class="gg-process__n" aria-hidden="true">1</span>
          <h3>Send your address.</h3>
          <p>Tell us which lawn to review and how to reach you.</p>
        </article>
        <article>
          <span class="gg-process__n" aria-hidden="true">2</span>
          <h3>Get your estimate.</h3>
          <p>Our local team prepares your lawn program and pricing.</p>
        </article>
        <article>
          <span class="gg-process__n" aria-hidden="true">3</span>
          <h3>Make it official.</h3>
          <p>
            {
              offerActive
                ? "Accept when you’re ready. Your November discount applies to your first lawn treatment, up to $75 off."
                : "Accept when you’re ready. Your estimate confirms the details for your lawn."
            }
          </p>
        </article>
      </div>
      <div class="gg-process__cta">
        <button class="gg-scroll-button" type="button" data-scroll-to-estimate>
          {offerActive ? "Claim 50% off my first treatment" : "Get my free estimate"}
          <span aria-hidden="true">→</span>
        </button>
      </div>
    </div>
  </div>

  <div class="gg-section">
    <div class="gg-shell gg-faq-wrap">
      <div class="gg-faq-intro">
        <span class="gg-section-label">Good questions. Clear answers.</span>
        <h2>Before we get growing.</h2>
        <p>
          Prefer to talk it through?<br />
          Call <a href={`tel:${site.phoneTel}`}><strong>{site.phone}</strong></a>.
        </p>
      </div>
      <div>
        {
          offerActive && (
            <details open>
              <summary>How does the November offer work?</summary>
              <p>
                Request your free lawn treatment estimate through this page. When you sign up through
                this November offer, you receive 50% off your first lawn treatment, with a maximum
                discount of $75. For example, a $100 first treatment saves $50; a $200 first treatment
                saves $75. The offer applies to the first lawn treatment, rather than an ongoing
                monthly discount. Your estimate will confirm the details.
              </p>
            </details>
          )
        }
        <details open={!offerActive}>
          <summary>How much will my lawn program cost?</summary>
          <p>
            Pricing depends on lawn size and property needs. We’ll prepare a written estimate so you
            can see your program and price before deciding. Requesting an estimate does not enroll
            you or authorize a charge. {site.startingPrice.short}
          </p>
        </details>
        <details>
          <summary>Do you mow lawns too?</summary>
          <p>
            We specialize in lawn fertilization and weed control. Mowing is not part of this lawn
            treatment program.
          </p>
        </details>
        <details>
          <summary>When will I hear back?</summary>
          <p>
            Most estimates are sent within one business day. Requests received after office hours are
            handled when our local team returns ({site.hours.label}).
          </p>
        </details>
      </div>
    </div>
  </div>

  <div class="gg-final">
    <div class="gg-shell gg-final-grid">
      <div>
        <h2>A better lawn starts with a plan.</h2>
        <p>
          {
            offerActive
              ? "Start yours with 50% off your first lawn treatment. Up to $75 off."
              : "Start with a free estimate from your local, firefighter-owned team."
          }
        </p>
      </div>
      <button class="gg-scroll-button" type="button" data-scroll-to-estimate>
        Get My Free Estimate <span aria-hidden="true">→</span>
      </button>
    </div>
  </div>

  <footer class="gg-shell gg-footer">
    {
      offerActive ? (
        <p>
          <strong>November offer:</strong> 50% off the first lawn treatment, maximum savings $75.
          Requesting an estimate alone does not apply a discount. Regular program pricing applies to
          subsequent treatments. Offer details will be confirmed in your estimate.
        </p>
      ) : null
    }
    <p>
      Grow Green Weed Control · {coverageShortPhrase()} ·{" "}
      <a href={`tel:${site.phoneTel}`}>{site.phone}</a>
      {" · "}
      <a href="/">Home</a>
      {" · "}
      <a href="/contact-us/">Contact</a>
    </p>
  </footer>

  <div class="gg-sticky" aria-label="Request your lawn estimate">
    <button class="gg-sticky-button" type="button" data-scroll-to-estimate>
      {
        offerActive
          ? "Free Estimate · 50% Off First Treatment*"
          : "Get My Free Estimate"
      }
    </button>
  </div>
</section>

<style>
  #gg-fb-estimate {
    --ink: #103b25;
    --green: #24843d;
    --lime: #f5ce45;
    --cream: #f8fbf2;
    --line: #dce7d7;
    color: var(--ink);
    background: var(--cream);
    font-size: 16px;
    line-height: 1.6;
    isolation: isolate;
    position: relative;
    padding-bottom: 0;
    -webkit-font-smoothing: antialiased;
  }
  #gg-fb-estimate,
  #gg-fb-estimate * {
    box-sizing: border-box;
  }
  #gg-fb-estimate :global([hidden]) {
    display: none !important;
  }
  #gg-fb-estimate h1,
  #gg-fb-estimate h2,
  #gg-fb-estimate h3,
  #gg-fb-estimate p,
  #gg-fb-estimate ul {
    margin: 0;
    padding: 0;
    color: inherit;
  }
  #gg-fb-estimate h1,
  #gg-fb-estimate h2,
  #gg-fb-estimate h3 {
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 1.1;
  }
  #gg-fb-estimate h2 {
    font-size: clamp(30px, 3.2vw, 44px);
  }
  #gg-fb-estimate a {
    color: inherit;
    text-underline-offset: 4px;
  }
  #gg-fb-estimate img {
    display: block;
    max-width: 100%;
    height: auto;
  }
  #gg-fb-estimate button,
  #gg-fb-estimate input {
    font: inherit;
  }
  #gg-fb-estimate button {
    cursor: pointer;
  }
  #gg-fb-estimate button:disabled {
    cursor: wait;
    opacity: 0.65;
  }
  #gg-fb-estimate :focus-visible {
