    background: var(--lawn-gold);
    color: #172014;
    font-weight: 900;
    cursor: pointer;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.28);
  }
  .lawn-video__shell:has(video) .lawn-video__play {
    display: none;
  }
</style>

<script>
  (function () {
    const root = document.getElementById("gg-lawn-page");
    if (!root || root.dataset.ggInitialized === "true") return;
    root.dataset.ggInitialized = "true";

    const slider = root.querySelector("#ggl-slider");
    const sliderOutput = root.querySelector("#ggl-slider-output");
    const sqftOutput = root.querySelector("#ggl-estimate-sqft");
    const priceOutput = root.querySelector("#ggl-estimate-price");
    const presetButtons = root.querySelectorAll(".lawn-size-btn");
    const quoteForm = root.querySelector("[data-quote-form]");

    function formatMoney(number) {
      return number.toLocaleString("en-US", {
        style: "currency",
        currency: "USD",
        minimumFractionDigits: 2,
      });
    }

    function estimatePrice(squareFeet) {
      const monthly = (squareFeet / 1000) * 10 * (9 / 12);
      return Math.max(39, monthly);
    }

    function updateEstimator(sizeInThousands) {
      if (!(slider instanceof HTMLInputElement)) return;
      const size = Math.max(
        Number(slider.min),
        Math.min(Number(slider.max), Math.round(Number(sizeInThousands) || 5)),
      );
      const squareFeet = size * 1000;
      const monthly = estimatePrice(squareFeet);
      const fill = ((size - Number(slider.min)) / (Number(slider.max) - Number(slider.min))) * 100;

      slider.value = String(size);
      slider.style.setProperty("--lawn-fill", fill + "%");
      if (sliderOutput) sliderOutput.textContent = squareFeet.toLocaleString("en-US") + " sq ft";
      if (sqftOutput) sqftOutput.textContent = squareFeet.toLocaleString("en-US");
      if (priceOutput) priceOutput.textContent = formatMoney(monthly);
      presetButtons.forEach((button) => {
        button.classList.toggle("is-active", Number(button.dataset.size) === size);
      });

      if (quoteForm instanceof HTMLElement) {
        quoteForm.dataset.extraNotes = [
          "Service requested: Lawn Fertilization & Weed Control",
          `Estimator selection: ${squareFeet} sq ft / ${formatMoney(monthly)} estimated monthly`,
        ].join("\n");
      }
    }

    if (slider instanceof HTMLInputElement) {
      slider.addEventListener("input", () => updateEstimator(slider.value));
      presetButtons.forEach((button) => {
        button.addEventListener("click", () => updateEstimator(button.dataset.size));
      });
      updateEstimator(slider.value);
    }

    root.querySelectorAll('a[href="#ggl-quote"]').forEach((link) => {
      link.addEventListener("click", (event) => {
        event.preventDefault();
        if (quoteForm instanceof HTMLElement && link instanceof HTMLElement && link.dataset.quoteSource) {
          const label = `Lawn Service Page — ${link.dataset.quoteSource}`;
          quoteForm.dataset.source = label;
          quoteForm.dataset.leadSource = label;
        }
        root.querySelector("#ggl-quote")?.scrollIntoView({ behavior: "smooth", block: "start" });
      });
    });

    const wrap = root.querySelector(".gg-video-wrap");
    const playBtn = wrap?.querySelector(".lawn-video__play");
    playBtn?.addEventListener("click", () => {
      if (!(wrap instanceof HTMLElement)) return;
      const src = wrap.getAttribute("data-video-src");
      const poster = wrap.getAttribute("data-video-poster");
      if (!src) return;
      const posterImg = wrap.querySelector(".lawn-video__poster");
      const player = document.createElement("video");
      player.className = "lawn-video__poster";
      player.controls = true;
      player.playsInline = true;
      player.setAttribute("preload", "metadata");
      if (poster) player.setAttribute("poster", poster);
      const source = document.createElement("source");
      source.src = src;
      source.type = "video/mp4";
      player.appendChild(source);
      posterImg?.replaceWith(player);
      playBtn.remove();
      player.play().catch(() => {});
    });
  })();
</script>
