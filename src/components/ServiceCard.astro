---
import type { Service } from "../data/services";
import { serviceMediaBySlug } from "../data/service-media";

interface Props {
  service: Service;
}

const { service } = Astro.props;
const media = serviceMediaBySlug[service.slug];
const blurb = media?.blurb || service.summary;
const href = service.path || `/${service.slug}/`;
---

<a class="service-card" href={href}>
  {
    media?.image ? (
      <div class="media">
        <img src={media.image} alt={media.imageAlt || ""} loading="lazy" width="640" height="400" />
      </div>
    ) : (
      <div class="media branded" aria-hidden="true">
        <img src="/images/mascot/thumbs-up.png" alt="" width="88" height="88" loading="lazy" />
      </div>
    )
  }
  <div class="body">
    <h3>{service.title}</h3>
    <p>{blurb}</p>
    <span class="more">Learn more →</span>
  </div>
</a>

<style>
  .service-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    background: #fff;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid #dbe6de;
    box-shadow: 0 12px 30px rgba(17, 45, 27, 0.08);
    transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease;
    height: 100%;
  }
  .service-card:hover {
    transform: translateY(-3px);
    border-color: #9bc2a6;
    box-shadow: 0 18px 40px rgba(17, 45, 27, 0.12);
  }
  .media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--green-100);
  }
  .media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
    transition: transform 0.45s ease;
  }
  .service-card:hover .media img {
    transform: scale(1.04);
  }
  .media.branded {
    display: grid;
    place-items: center;
    background:
      radial-gradient(circle at 30% 20%, rgba(242, 162, 10, 0.22), transparent 50%),
      linear-gradient(145deg, var(--green-800), var(--green-950));
  }
  .media.branded img {
    width: 72px;
    height: auto;
    object-fit: contain;
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1rem 1.05rem 1.15rem;
    flex: 1;
  }
  .body h3 {
    margin: 0;
    font-size: var(--fs-card);
    line-height: 1.2;
    font-weight: 900;
    color: var(--ink);
  }
  .body p {
    margin: 0;
    color: var(--muted);
    font-size: 0.94rem;
    line-height: 1.5;
  }
  .more {
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid #e3ebe5;
    color: var(--green-600);
    font-weight: 900;
    font-size: 0.92rem;
  }
</style>
