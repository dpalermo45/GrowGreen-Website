<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

<script>
  const root = document.querySelector<HTMLElement>("[data-liquid-page]");
  if (root) {
    const notes = root.querySelector<HTMLTextAreaElement>('textarea[name="notes"]');
    const PREFIX = "Service requested: Liquid Aeration";

    if (notes) {
      const seed = () => {
        const value = notes.value.trim();
        if (!value) notes.value = `${PREFIX}\n`;
        else if (!value.toLowerCase().includes("liquid aeration")) notes.value = `${PREFIX}\n${value}`;
      };
      seed();
      notes.addEventListener("focus", seed, { once: true });
    }
  }
</script>
