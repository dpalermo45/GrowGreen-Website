---
import QuoteForm from "./QuoteForm.astro";
import { site } from "../data/site";
import type { CampaignOffer } from "../data/campaigns";
import { coverageShortPhrase } from "../data/service-areas";
import {
  offer25Landings,
  type Offer25Key,
  type Offer25LandingCopy,
} from "../data/offer25-landings";

interface Props {
  campaign: CampaignOffer;
  offerActive: boolean;
  channel: Offer25Key;
}

const { campaign, offerActive, channel } = Astro.props;
const copy: Offer25LandingCopy = offer25Landings[channel];

const leadSource = campaign.leadSourceHint || copy.leadSourceFallback;
const promotion = offerActive
  ? campaign.offerDetail || copy.promotionFallback
  : "";
const offerConfirm = offerActive
  ? `${copy.offerBannerTitle}. ${copy.offerBannerBody}`
  : "";

const coverage = coverageShortPhrase();
const eyebrow = copy.appendCoverageToEyebrow
  ? `${copy.eyebrow} · ${coverage}`
  : copy.eyebrow;

const h1 = offerActive ? copy.h1Active : copy.h1Inactive;

const steps = [
  {
    n: "1",
    title: "Send your lawn address",
    body: "Use the form above — suggestions help fill city and ZIP, or enter them manually.",
  },
  {
    n: "2",
    title: "We prepare your estimate",
    body: "Our St. Amant office reviews the property and follows up during business hours.",
  },
  {
    n: "3",
    title: offerActive ? copy.step3TitleActive : "Start when you’re ready",
    body: offerActive
      ? copy.step3BodyActive
      : "Review the plan with our team and start only when it makes sense for your yard.",
  },
];

const bandImage =
  copy.bandImage === "lawn"
    ? {
        src: "/images/parishes/residential-front-lawn-curb-appeal-960.webp",
        srcset:
          "/images/parishes/residential-front-lawn-curb-appeal-640.webp 640w, /images/parishes/residential-front-lawn-curb-appeal-960.webp 960w, /images/parishes/residential-front-lawn-curb-appeal-1280.webp 1280w",
        alt: "Well-maintained South Louisiana lawn",
      }
    : {
        src: "/images/hero/truck-and-trailer-960.webp",
        srcset:
          "/images/hero/truck-and-trailer-640.webp 640w, /images/hero/truck-and-trailer-960.webp 960w, /images/hero/truck-and-trailer-1280.webp 1280w",
        alt: "Grow Green Weed Control truck and trailer",
      };
const attrs = { [copy.dataAttr]: true };
---

<section class="nd" aria-label={copy.ariaLabel} {...attrs}>
  <div class="nd-topline">
    {
      offerActive ? (
        <>
          <span>{copy.toplineChannel}</span>
          <span class="nd-topline__dot" aria-hidden="true" />
          <strong>{copy.toplineOffer}</strong>
          <span class="nd-topline__dot" aria-hidden="true" />
          <span>Free local estimate</span>
        </>
      ) : (
        <>
          <span>Free estimate</span>
          <span class="nd-topline__dot" aria-hidden="true" />
          <strong>Lawn fertilization &amp; weed control</strong>
          <span class="nd-topline__dot" aria-hidden="true" />
          <span>Plans start at ${site.startingPrice.amount}/{site.startingPrice.period}</span>
        </>
      )
    }
  </div>

  <header class="nd-header">
    <a class="nd-logo" href="/" aria-label={`${site.name} home`}>
      <img
        src="/images/brand/logo-128.webp"
        srcset="/images/brand/logo-64.webp 64w, /images/brand/logo-128.webp 128w, /images/brand/logo-192.webp 192w"
        sizes="52px"
        width="52"
        height="52"
        alt=""
        decoding="async"
      />
      <span>
        <strong>Grow Green</strong>
        <small>Weed Control</small>
      </span>
    </a>
    <div class="nd-header__right">
      <span class="nd-header__tag">Firefighter-owned · Local</span>
      <a class="nd-phone" href={`tel:${site.phoneTel}`}>{site.phone}</a>
    </div>
  </header>

  <div class="nd-hero">
    <div class={`nd-hero__media nd-hero__media--${copy.heroMedia}`} aria-hidden="true"></div>
    <div class="nd-hero__veil" aria-hidden="true"></div>
    <div class="nd-hero__grain" aria-hidden="true"></div>
    <div class="nd-hero__inner">
      <div class="nd-hero__copy nd-rise">
        <p class="nd-eyebrow">{eyebrow}</p>
        <p class="nd-brand">Grow Green Weed Control</p>
        <h1>
          {h1.before}
          {h1.breakBeforeEmphasis ? <br /> : " "}
          {h1.emphasisPrefix}
          <em>{h1.emphasis}</em>
          {h1.after || ""}
        </h1>
        <p class="nd-lead">{offerActive ? copy.leadActive : copy.leadInactive}</p>
        <ul class="nd-points">
          <li>Local · family-owned · firefighter-owned</li>
          <li>Free, no-obligation estimate</li>
          <li>Plans start at ${site.startingPrice.amount}/{site.startingPrice.period}</li>
        </ul>
        <div class="nd-hero__actions">
          <a class="nd-btn nd-btn--gold" href="#nd-estimate">
            {offerActive ? copy.ctaPrimaryActive : "Request my estimate"}
          </a>
          <a class="nd-btn nd-btn--ghost" href={`tel:${site.phoneTel}`}>Call {site.phone}</a>
        </div>
      </div>

      <div class="nd-hero__form nd-rise nd-rise--delay" id="nd-estimate">
        {
          offerActive ? (
            <div class="nd-offer-banner">
              <div class="nd-offer-banner__price" aria-hidden="true">
                <span>$</span>25
              </div>
              <div>
                <strong>{copy.offerBannerTitle}</strong>
                <p>{copy.offerBannerBody}</p>
              </div>
            </div>
          ) : null
        }
        <QuoteForm
          source={copy.formSource}
          leadSource={leadSource}
          promotionCode={promotion}
          offerConfirm={offerConfirm}
          compact
          heading={offerActive ? copy.formHeadingActive : "Request your free estimate"}
          subheading={
            offerActive
              ? copy.formSubActive
              : "Enter the lawn address for a clear, no-obligation estimate."
          }
        />
        <p class="nd-form-note">
          Office hours {site.hours.label} ·
          <a href={`tel:${site.phoneTel}`}>{site.phone}</a>
        </p>
      </div>
    </div>
  </div>

  <section class="nd-steps">
    <div class="nd-shell">
      <div class="nd-section-head nd-rise">
        <p class="nd-eyebrow nd-eyebrow--dark">Simple next steps</p>
        <h2>{offerActive ? copy.stepsTitleActive : "How your estimate works"}</h2>
        <p>
          No pressure pitch. Send the address, talk with our local office, and decide when you’re ready.
        </p>
      </div>
      <ol class="nd-steps__list">
        {
          steps.map((step, i) => (
            <li class={`nd-step nd-rise nd-rise--d${i + 1}`}>
              <span class="nd-step__n" aria-hidden="true">
                {step.n}
              </span>
              <div>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="nd-local">
    <div class="nd-shell nd-local__grid">
      <figure class="nd-local__photo nd-rise">
        <img
          src="/images/parishes/residential-front-lawn-curb-appeal-960.webp"
          srcset="/images/parishes/residential-front-lawn-curb-appeal-640.webp 640w, /images/parishes/residential-front-lawn-curb-appeal-960.webp 960w, /images/parishes/residential-front-lawn-curb-appeal-1280.webp 1280w"
          sizes="(max-width: 900px) 100vw, 48vw"
          width="960"
          height="720"
          alt="South Louisiana front lawn with clean curb appeal"
          loading="lazy"
          decoding="async"
        />
      </figure>
      <div class="nd-local__copy nd-rise nd-rise--delay">
        <p class="nd-eyebrow nd-eyebrow--dark">{copy.localEyebrow}</p>
        <h2>Local routes. Real office. Clear visit notes.</h2>
        <p>
          Grow Green treats lawns across {coverage} with seasonal timing for our heat and humidity —
          and a St. Amant office you can actually reach.
        </p>
        <ul class="nd-checklist">
          <li>Programs built for warm-season turf, not a national one-size schedule</li>
          <li>Reminders and visit details so you know what was done</li>
          <li>Firefighter-owned, family-operated team based in {site.address.city}</li>
        </ul>
        <div class="nd-local__meta">
          <img
            class="nd-local__owner"
            src="/images/about/owner-with-son-640.webp"
            width="64"
            height="64"
            alt=""
            loading="lazy"
            decoding="async"
          />
          <div>
            <strong>Local ownership you can talk to</strong>
            <span>
              Call <a href={`tel:${site.phoneTel}`}>{site.phone}</a> · {site.hours.label}
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="nd-truck">
    <div class="nd-shell nd-truck__grid">
      <div class="nd-truck__copy nd-rise">
        <p class="nd-eyebrow">{copy.bandEyebrow}</p>
        <h2>{copy.bandTitle}</h2>
        <p>{copy.bandBody}</p>
        <a class="nd-btn nd-btn--gold" href="#nd-estimate">
          {offerActive ? copy.bandCtaActive : "Request my free estimate"}
        </a>
      </div>
      <figure class="nd-truck__photo nd-rise nd-rise--delay">
        <img
          src={bandImage.src}
          srcset={bandImage.srcset}
          sizes="(max-width: 900px) 100vw, 46vw"
          width="960"
          height="720"
          alt={bandImage.alt}
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>
  </section>

  <section class="nd-faq">
    <div class="nd-shell nd-faq__inner">
      <div class="nd-section-head nd-rise">
        <p class="nd-eyebrow nd-eyebrow--dark">Before you submit</p>
        <h2>Quick answers</h2>
      </div>
      <div class="nd-faq__list">
        {
          offerActive ? (
            <details class="nd-faq__item" open>
              <summary>{copy.faqOfferSummary}</summary>
              <p>{copy.faqOfferBody}</p>
            </details>
          ) : null
        }
        <details class="nd-faq__item" open={!offerActive}>
          <summary>How fast will I hear back?</summary>
          <p>
            Usually the same business day during office hours ({site.hours.label}), or by the next business day in
            busier periods.
          </p>
        </details>
        <details class="nd-faq__item">
          <summary>What happens after I submit?</summary>
          <p>{copy.faqSubmitBody}</p>
        </details>
        <details class="nd-faq__item">
          <summary>Where do you service?</summary>
          <p>
            We serve {coverage}, including Prairieville, Gonzales, St. Amant, Denham Springs, Walker,
            Central, Zachary, and nearby communities.
          </p>
        </details>
      </div>
    </div>
  </section>

  <section class="nd-close">
    <div class="nd-shell nd-close__inner nd-rise">
      <p class="nd-eyebrow">Ready when you are</p>
      <h2>
        {offerActive ? copy.closeTitleActive : "Request your free local estimate"}
      </h2>
      <p>
        Enter your service address above, or call{" "}
        <a href={`tel:${site.phoneTel}`}>{site.phone}</a> during office hours.
      </p>
      <div class="nd-close__actions">
        <a class="nd-btn nd-btn--gold" href="#nd-estimate">
          {offerActive ? copy.ctaPrimaryActive : "Back to the form"}
        </a>
        <a class="nd-btn nd-btn--ghost-dark" href={`tel:${site.phoneTel}`}>Call the office</a>
      </div>
    </div>
  </section>

  <footer class="nd-footer">
    <div class="nd-shell nd-footer__inner">
      <a class="nd-footer__brand" href="/">
        <img src="/images/brand/logo-128.webp" width="40" height="40" alt="" decoding="async" />
        <span>{site.name}</span>
      </a>
      <p>
        {site.address.full}
        <br />
        <a href={`tel:${site.phoneTel}`}>{site.phone}</a>
        ·
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <br />
        {site.hours.label}
      </p>
      <p class="nd-footer__links">
        <a href="/">Homepage</a>
        <a href="/privacy-policy/">Privacy</a>
        <a href="/terms-and-conditions/">Terms</a>
      </p>
    </div>
  </footer>
</section>

<style>
  .nd {
    --nd-forest: #0e2a1a;
    --nd-green: #2f7a43;
    --nd-gold: #f5a20a;
    --nd-gold-soft: #ffc857;
    --nd-ink: #14251a;
    --nd-muted: #53645a;
    --nd-cream: #f4f8f4;
    --nd-line: #d5e3d9;
    color: var(--nd-ink);
    background: #fff;
    font-family: var(--font-display), var(--font-body);
    scroll-behavior: smooth;
  }

  .nd-shell {
    width: min(1100px, calc(100% - 2rem));
    margin-inline: auto;
  }

  .nd-topline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.4rem 0.65rem;
    background: linear-gradient(90deg, #0a2215, #143524 50%, #0a2215);
    color: #e7f1ea;
    text-align: center;
    padding: 0.55rem 1rem;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .nd-topline strong {
    color: var(--nd-gold-soft);
    font-weight: 900;
    letter-spacing: 0.04em;
  }
  .nd-topline__dot {
    width: 0.28rem;
    height: 0.28rem;
    border-radius: 50%;
    background: rgba(245, 162, 10, 0.85);
  }

  .nd-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.65rem 1.1rem;
    background: rgba(255, 255, 255, 0.96);
    border-bottom: 1px solid var(--nd-line);
    position: sticky;
    top: 0;
    z-index: 40;
    backdrop-filter: blur(10px);
  }
  .nd-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    color: var(--nd-ink);
  }
  .nd-logo img {
    width: 52px;
    height: 52px;
    object-fit: contain;
  }
  .nd-logo span {
    display: grid;
    line-height: 1.05;
  }
  .nd-logo strong {
    font-size: 1.08rem;
    font-weight: 900;
    letter-spacing: -0.03em;
    color: var(--nd-forest);
  }
  .nd-logo small {
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: #6a7d71;
  }
  .nd-header__right {
    display: grid;
    justify-items: end;
    gap: 0.1rem;
  }
  .nd-header__tag {
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #6f8175;
  }
  .nd-phone {
    font-weight: 900;
    font-size: 1.02rem;
    color: var(--nd-forest);
    text-decoration: none;
    letter-spacing: -0.02em;
  }
  .nd-phone:hover {
    color: var(--nd-green);
  }

  .nd-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    color: #fff;
    background: #07180f;
  }
  .nd-hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
    transform: scale(1.04);
    animation: nd-ken 18s ease-in-out infinite alternate;
    background: center / cover no-repeat;
  }
  .nd-hero__media--lawn {
    background-image: url("/images/home/hero-lawn-640.webp");
  }
  .nd-hero__media--truck-and-trailer {
    background-image: url("/images/hero/truck-and-trailer-640.webp");
  }
  .nd-hero__media--f250-side-view {
    background-image: url("/images/hero/f250-side-view-640.webp");
  }
  @media (min-width: 700px) {
    .nd-hero__media--lawn {
      background-image: url("/images/home/hero-lawn-960.webp");
    }
    .nd-hero__media--truck-and-trailer {
      background-image: url("/images/hero/truck-and-trailer-960.webp");
    }
    .nd-hero__media--f250-side-view {
      background-image: url("/images/hero/f250-side-view-960.webp");
    }
  }
  @media (min-width: 1100px) {
    .nd-hero__media--lawn {
      background-image: url("/images/home/hero-lawn-1280.webp");
    }
    .nd-hero__media--truck-and-trailer {
      background-image: url("/images/hero/truck-and-trailer-1280.webp");
    }
    .nd-hero__media--f250-side-view {
      background-image: url("/images/hero/f250-side-view-1280.webp");
    }
  }
  @media (min-width: 1500px) {
    .nd-hero__media--lawn {
      background-image: url("/images/home/hero-lawn-1600.webp");
    }
    .nd-hero__media--truck-and-trailer {
      background-image: url("/images/hero/truck-and-trailer-1920.webp");
    }
    .nd-hero__media--f250-side-view {
      background-image: url("/images/hero/f250-side-view-1920.webp");
    }
  }
  .nd-hero__veil {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      radial-gradient(ellipse 50% 65% at 82% 38%, rgba(47, 122, 67, 0.2), transparent 58%),
      linear-gradient(108deg, rgba(5, 22, 13, 0.93) 0%, rgba(5, 22, 13, 0.8) 36%, rgba(5, 22, 13, 0.4) 70%, rgba(5, 22, 13, 0.58) 100%);
  }
  .nd-hero__grain {
    position: absolute;
    inset: 0;
    z-index: 1;
    opacity: 0.1;
    pointer-events: none;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.55'/%3E%3C/svg%3E");
  }
  .nd-hero__inner {
    position: relative;
    z-index: 2;
    width: min(1120px, calc(100% - 2rem));
    margin: 0 auto;
    padding: 2rem 0 2.4rem;
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 980px) {
    .nd-hero__inner {
      grid-template-columns: 1.05fr 0.95fr;
      align-items: center;
      gap: 2rem;
      padding: 2.6rem 0 3rem;
    }
    .nd-hero__actions {
      display: none;
    }
  }

  #nd-estimate {
    scroll-margin-top: 5.5rem;
  }

  .nd-eyebrow {
    margin: 0 0 0.6rem;
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #c9ddcf;
  }
  .nd-eyebrow--dark {
    color: var(--nd-green);
  }
  .nd-brand {
    margin: 0 0 0.45rem;
    font-size: clamp(1.45rem, 3vw, 2rem);
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 1;
    color: #fff;
    text-shadow: 0 2px 16px rgba(0, 0, 0, 0.22);
  }
  .nd-hero__copy h1 {
    margin: 0 0 0.8rem;
    font-size: clamp(2.2rem, 5vw, 3.45rem);
    line-height: 0.98;
    letter-spacing: -0.045em;
    color: #fff;
    font-weight: 900;
  }
  .nd-hero__copy h1 em {
    font-style: normal;
    color: var(--nd-gold);
  }
  .nd-lead {
    margin: 0 0 1rem;
    max-width: 33rem;
    font-size: 1.05rem;
    line-height: 1.55;
    color: #e2efe6;
    font-weight: 500;
  }
  .nd-points {
    list-style: none;
    margin: 0 0 1.2rem;
    padding: 0;
    display: grid;
    gap: 0.42rem;
  }
  .nd-points li {
    position: relative;
    padding-left: 1.1rem;
    font-weight: 750;
    color: #d8eadc;
    font-size: 0.98rem;
  }
  .nd-points li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--nd-gold);
  }
  .nd-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .nd-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0.72rem 1.15rem;
    border-radius: 0.75rem;
    font-weight: 900;
    text-decoration: none;
    letter-spacing: -0.01em;
    transition: transform 0.16s ease, box-shadow 0.16s ease, background 0.16s ease, border-color 0.16s ease;
  }
  .nd-btn:hover {
    transform: translateY(-1px);
  }
  .nd-btn--gold {
    background: linear-gradient(180deg, #ffb225, var(--nd-gold));
    color: #172014;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2);
  }
  .nd-btn--ghost {
    background: transparent;
    color: #fff;
    border: 1.5px solid rgba(255, 255, 255, 0.5);
  }
  .nd-btn--ghost:hover {
    border-color: #fff;
  }
  .nd-btn--ghost-dark {
    background: transparent;
    color: #fff;
    border: 1.5px solid rgba(255, 255, 255, 0.45);
  }
  .nd-btn--ghost-dark:hover {
    border-color: #fff;
    background: rgba(255, 255, 255, 0.06);
  }

  .nd-hero__form {
    background: #fff;
    color: var(--nd-ink);
    border-radius: 1.15rem;
    padding: 0.95rem 0.95rem 1rem;
    box-shadow: 0 22px 48px rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.5);
  }
  .nd-offer-banner {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin: 0 0 0.75rem;
    padding: 0.72rem 0.85rem;
    border-radius: 0.85rem;
    background: linear-gradient(135deg, #fff8ea 0%, #f4faf5 100%);
    border: 1px solid #e6d4a4;
  }
  .nd-offer-banner__price {
    flex: 0 0 auto;
    min-width: 3.35rem;
    height: 3.35rem;
    display: grid;
    place-items: center;
    border-radius: 0.75rem;
    background: var(--nd-forest);
    color: var(--nd-gold);
    font-size: 1.28rem;
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .nd-offer-banner__price span {
    font-size: 0.8rem;
    margin-right: 0.04rem;
  }
