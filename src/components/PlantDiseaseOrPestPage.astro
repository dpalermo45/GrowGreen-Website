<script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<script>
  const root = document.querySelector<HTMLElement>("[data-opdp-page]");
  if (root) {
    const notes = root.querySelector<HTMLTextAreaElement>('textarea[name="notes"]');
    const buttons = root.querySelectorAll<HTMLButtonElement>("[data-pick-concern]");
    const plantInput = root.querySelector<HTMLInputElement>("[data-opdp-plant]");
    const countInput = root.querySelector<HTMLInputElement>("[data-opdp-count]");
    const onsetSelect = root.querySelector<HTMLSelectElement>("[data-opdp-onset]");
    const SERVICE_PREFIX = root.dataset.serviceNote || "Service requested: Ornamental Plant Disease/Pest";
    const CONCERN_PREFIX = "Closest description: ";
    const PLANT_PREFIX = "Plants affected: ";
    const COUNT_PREFIX = "Plant count: ";
    const ONSET_PREFIX = "First noticed: ";

    function managedPrefixes() {
      return [SERVICE_PREFIX.split(":")[0] + ":", CONCERN_PREFIX, PLANT_PREFIX, COUNT_PREFIX, ONSET_PREFIX];
    }

    function isManaged(line: string) {
      return managedPrefixes().some((prefix) => line.startsWith(prefix));
    }

    function userLines() {
      return (notes?.value || "")
        .split("\n")
        .map((line) => line.trim())
        .filter(Boolean)
        .filter((line) => !isManaged(line));
    }

    function syncNotes(concern?: string) {
      if (!notes) return;
      const lines: string[] = [SERVICE_PREFIX];
      const activeConcern =
        concern ||
        [...buttons].find((b) => b.classList.contains("is-active"))?.dataset.pickConcern ||
        "";
      if (activeConcern) lines.push(`${CONCERN_PREFIX}${activeConcern}`);
      const plant = plantInput?.value.trim();
      if (plant) lines.push(`${PLANT_PREFIX}${plant}`);
      const count = countInput?.value.trim();
      if (count) lines.push(`${COUNT_PREFIX}${count}`);
      const onset = onsetSelect?.value.trim();
      if (onset) lines.push(`${ONSET_PREFIX}${onset}`);
      notes.value = [...lines, ...userLines()].join("\n");
    }

    function applyConcern(value: string) {
      buttons.forEach((b) => b.classList.toggle("is-active", b.dataset.pickConcern === value));
      syncNotes(value);
    }

    syncNotes();
    notes?.addEventListener("blur", () => syncNotes());
    plantInput?.addEventListener("change", () => syncNotes());
    plantInput?.addEventListener("blur", () => syncNotes());
    countInput?.addEventListener("change", () => syncNotes());
    countInput?.addEventListener("blur", () => syncNotes());
    onsetSelect?.addEventListener("change", () => syncNotes());

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        const value = button.dataset.pickConcern || "";
        if (!value) return;
        applyConcern(value);
        const quote = document.getElementById("opdp-quote");
        quote?.scrollIntoView({ behavior: "smooth", block: "start" });
        window.setTimeout(() => notes?.focus({ preventScroll: true }), 500);
      });
    });
  }
</script>
