---
import { site } from "../data/site";

interface Props {
  heading?: string;
  text?: string;
  href?: string;
  label?: string;
}

const {
  heading = "Ready for a clearer plan for your lawn?",
  text = site.startingPrice.short,
  href = "/request-a-quote/",
  label = "Get My Free Quote",
} = Astro.props;
---

<section class="cta-band" aria-label="Request a free estimate">
  <div class="container cta-inner">
    <div class="cta-copy">
      <p class="eyebrow eyebrow-light">Free local lawn estimate</p>
      <h2>{heading}</h2>
      <p>{text}</p>
    </div>
    <div class="cta-actions">
      <a class="btn btn-gold" href={href}>{label}</a>
      <a class="btn cta-band__phone" href={`tel:${site.phoneTel}`}>Call {site.phone}</a>
    </div>
  </div>
</section>

<style>
  .cta-band {
    position: relative;
    overflow: hidden;
    padding: clamp(3.4rem, 6.5vw, 4.85rem) 0;
    background:
      radial-gradient(circle at 12% 15%, rgba(75, 161, 92, 0.26), transparent 28%),
      radial-gradient(circle at 92% 78%, rgba(242, 170, 43, 0.1), transparent 30%),
      linear-gradient(120deg, #06180e, #0c2a18 58%, #134226);
    color: #fff;
    isolation: isolate;
  }
  .cta-band::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.35;
    background:
      repeating-linear-gradient(
        -18deg,
        transparent 0 18px,
        rgba(255, 255, 255, 0.028) 18px 19px
      );
    mask-image: linear-gradient(90deg, rgba(0, 0, 0, 0.55), transparent 70%);
  }
  .cta-band::after {
    content: "";
    position: absolute;
    top: 0;
    right: 0;
    width: 34%;
    height: 5px;
    background: var(--gold-soft);
  }
  .cta-band h2 {
    color: #fff;
    margin: 0 0 0.55rem;
    max-width: 18ch;
    font-size: clamp(1.75rem, 3.2vw, 2.55rem);
    letter-spacing: -0.035em;
    line-height: 1.05;
  }
  .cta-band p:not(.eyebrow) {
    color: #d8e6dc;
    margin: 0;
    max-width: 36rem;
    font-size: 1.02rem;
    line-height: 1.6;
  }
  .cta-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 1.75rem 2.5rem;
    justify-content: space-between;
    align-items: center;
  }
  .cta-copy :global(.eyebrow) {
    margin-bottom: 0.85rem;
  }
  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  /* Ghost phone — Core final-CTA energy; stays visible on dark (avoids global a:hover green) */
  .cta-band__phone {
    background: transparent;
    color: #fff;
    border: 1.5px solid rgba(255, 255, 255, 0.55);
    box-shadow: none;
  }
  .cta-band__phone:hover {
    border-color: #fff;
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
  }
</style>
