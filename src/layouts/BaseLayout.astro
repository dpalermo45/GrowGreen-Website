---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";
import { normalizeSeoText } from "../lib/seoText";

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  ogImage?: string;
  noindex?: boolean;
  /**
   * Explicit robots directive when set (e.g. "noindex, follow" for campaign LPs).
   * When omitted: noindex → "noindex, nofollow"; else index/follow gated by PUBLIC_SITE_INDEXING.
   */
  robots?: string;
  /** Self-contained campaign landings that ship their own header/footer chrome. */
  hideChrome?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title: titleRaw,
  description: descriptionRaw = "Local lawn fertilization and weed control for South Louisiana. Firefighter-owned. Free estimates.",
  canonicalPath = Astro.url.pathname,
  ogImage = site.defaultOgImage,
  noindex,
  robots: robotsProp,
  hideChrome = false,
  jsonLd,
} = Astro.props;

const title = normalizeSeoText(titleRaw) || titleRaw;
const description = normalizeSeoText(descriptionRaw) || descriptionRaw;

const indexingEnabled = import.meta.env.PUBLIC_SITE_INDEXING === "true";
const robotsContent =
  robotsProp?.trim() ||
  (noindex || !indexingEnabled ? "noindex, nofollow" : "index, follow");
const siteUrl = Astro.site?.toString().replace(/\/$/, "") || "https://growgreenweedcontrol.com";
const canonical = `${siteUrl}${canonicalPath.startsWith("/") ? canonicalPath : `/${canonicalPath}`}`;
const absoluteOg = ogImage.startsWith("http") ? ogImage : `${siteUrl}${ogImage}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robotsContent} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absoluteOg} />
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOg} />
    <link rel="icon" href="/images/brand/favicon-32.png?v=4" type="image/png" sizes="32x32" />
    <link rel="icon" href="/images/brand/favicon-48.png?v=4" type="image/png" sizes="48x48" />
    <link rel="icon" href="/images/brand/favicon.png?v=4" type="image/png" sizes="180x180" />
    <link rel="apple-touch-icon" href="/images/brand/favicon.png?v=4" />
    <link
      rel="preload"
      href="/fonts/nunito-sans-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <style is:inline>
      @font-face {
        font-family: "Nunito Sans";
        font-style: normal;
        font-weight: 500 900;
        font-display: swap;
        src: url("/fonts/nunito-sans-latin.woff2") format("woff2");
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329,
          U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
    </style>
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
    <!-- Tracking hooks (IDs deferred): data-ggwc-analytics-slot -->
    <slot name="head" />
  </head>
  <body data-ggwc-analytics-slot="ready">
    <a class="skip-link" href="#main">Skip to content</a>
    {!hideChrome && <Header />}
    <main id="main">
      <slot />
    </main>
    {!hideChrome && <Footer />}
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      window.ggwcTrack = function ggwcTrack(eventName, payload) {
        window.dataLayer.push({ event: eventName, ...payload });
      };
    </script>
  </body>
</html>
