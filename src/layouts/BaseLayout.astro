---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";
import { normalizeMetaPixelId } from "../lib/analytics/metaPixel";
import { normalizeSeoText } from "../lib/seoText";

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  ogImage?: string;
  noindex?: boolean;
  /**
   * Explicit robots directive when set (e.g. "noindex, follow" for campaign LPs).
   * When omitted: noindex → "noindex, nofollow"; else index/follow gated by PUBLIC_SITE_INDEXING.
   */
  robots?: string;
  /** Self-contained campaign landings that ship their own header/footer chrome. */
  hideChrome?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title: titleRaw,
  description: descriptionRaw = "Local lawn fertilization and weed control for South Louisiana. Firefighter-owned. Free estimates.",
  canonicalPath = Astro.url.pathname,
  ogImage = site.defaultOgImage,
  noindex,
  robots: robotsProp,
  hideChrome = false,
  jsonLd,
} = Astro.props;

const title = normalizeSeoText(titleRaw) || titleRaw;
const description = normalizeSeoText(descriptionRaw) || descriptionRaw;

const indexingEnabled = import.meta.env.PUBLIC_SITE_INDEXING === "true";
const robotsContent =
  robotsProp?.trim() ||
  (noindex || !indexingEnabled ? "noindex, nofollow" : "index, follow");
const siteUrl = Astro.site?.toString().replace(/\/$/, "") || "https://growgreenweedcontrol.com";
const canonical = `${siteUrl}${canonicalPath.startsWith("/") ? canonicalPath : `/${canonicalPath}`}`;
const absoluteOg = ogImage.startsWith("http") ? ogImage : `${siteUrl}${ogImage}`;
// Empty locally / on preview builds → no Pixel script. Production: set PUBLIC_META_PIXEL_ID at build.
const metaPixelId = normalizeMetaPixelId(
  import.meta.env.PUBLIC_META_PIXEL_ID || process.env.PUBLIC_META_PIXEL_ID || "",
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robotsContent} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absoluteOg} />
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOg} />
    <link rel="icon" href="/images/brand/favicon-32.png?v=4" type="image/png" sizes="32x32" />
    <link rel="icon" href="/images/brand/favicon-48.png?v=4" type="image/png" sizes="48x48" />
    <link rel="icon" href="/images/brand/favicon.png?v=4" type="image/png" sizes="180x180" />
    <link rel="apple-touch-icon" href="/images/brand/favicon.png?v=4" />
    <link
      rel="preload"
      href="/fonts/nunito-sans-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <style is:inline>
      @font-face {
        font-family: "Nunito Sans";
        font-style: normal;
        font-weight: 500 900;
        font-display: swap;
        src: url("/fonts/nunito-sans-latin.woff2") format("woff2");
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329,
          U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
    </style>
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
    <!-- Analytics: Meta Pixel PageView when PUBLIC_META_PIXEL_ID is set (production). -->
    {
      metaPixelId ? (
        <script
          is:inline
          set:html={`
(function () {
  var PIXEL_ID = ${JSON.stringify(metaPixelId)};
  if (!PIXEL_ID) return;
  if (window.__ggwcMarketingConsent === false) return;

  !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
  n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
  n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;
  t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script',
  'https://connect.facebook.net/en_US/fbevents.js');

  if (!window.__ggwcMetaPixelInitialized) {
    fbq('init', PIXEL_ID);
    window.__ggwcMetaPixelInitialized = PIXEL_ID;
  } else if (window.__ggwcMetaPixelInitialized !== PIXEL_ID) {
    return;
  }

  window.__ggwcMetaPageView = function ggwcMetaPageView() {
    if (window.__ggwcMarketingConsent === false) return;
    if (!window.__ggwcMetaPixelInitialized) return;
    var path = location.pathname + location.search;
    if (window.__ggwcMetaLastPageView === path) return;
    window.__ggwcMetaLastPageView = path;
    fbq('track', 'PageView');
  };

  window.__ggwcMetaPageView();
  if (!window.__ggwcMetaPageViewBound) {
    window.__ggwcMetaPageViewBound = true;
    document.addEventListener('astro:page-load', function () {
      if (typeof window.__ggwcMetaPageView === 'function') window.__ggwcMetaPageView();
    });
  }
})();
`}
        />
      ) : null
    }
    <slot name="head" />
  </head>
  <body data-ggwc-analytics-slot={metaPixelId ? "meta-pixel" : "ready"}>
    <a class="skip-link" href="#main">Skip to content</a>
    {!hideChrome && <Header />}
    <main id="main">
      <slot />
    </main>
    {!hideChrome && <Footer />}
    {
      metaPixelId ? (
        <noscript>
          <img
            height="1"
            width="1"
            style="display:none"
            src={`https://www.facebook.com/tr?id=${metaPixelId}&ev=PageView&noscript=1`}
            alt=""
          />
        </noscript>
      ) : null
    }
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      window.ggwcTrack = function ggwcTrack(eventName, payload) {
        window.dataLayer.push({ event: eventName, ...payload });
      };
    </script>
  </body>
</html>
