# Public site
PUBLIC_SITE_URL=http://localhost:4321
# false keeps noindex for local/staging previews
PUBLIC_SITE_INDEXING=false

# CRM lead bridge (server-only — never expose in client code)
# mock = local fake CRM (default for development)
# live = real CRM (requires credentials; do not use for casual testing)
GGWC_CRM_MODE=mock
GGWC_CRM_BASE_URL=
GGWC_CRM_API_KEY=
# Optional override for public careers openings/applications (defaults to GGWC_CRM_BASE_URL or crm.growgreenweedcontrol.com)
# GGWC_CAREERS_CRM_BASE_URL=https://crm.growgreenweedcontrol.com

# Optional address autocomplete (browser-restricted public token)
PUBLIC_MAPBOX_TOKEN=

# Meta Pixel (PageView only). Leave empty for local/preview — no fbq load.
# Production Render: set PUBLIC_META_PIXEL_ID=1014961828315598 and rebuild.
PUBLIC_META_PIXEL_ID=

# Google Analytics 4 (page views only). Leave empty for local/preview — no gtag load.
# Production Render: set PUBLIC_GA_MEASUREMENT_ID=G-8PF7LD6SRT and rebuild.
PUBLIC_GA_MEASUREMENT_ID=

# Optional rate limit tuning
GGWC_LEAD_RATE_LIMIT_PER_IP=8
GGWC_LEAD_RATE_WINDOW_MS=600000

# ---------------------------------------------------------------------------
# Google Business Profile reviews (website OAuth client ONLY — not the CRM client)
# Project: ggwc-crm · OAuth client name: Grow Green Website Reviews
# Enter real values in local `.env` (never commit). Do not paste secrets into chat.
# ---------------------------------------------------------------------------
# GOOGLE_REVIEWS_CLIENT_ID=your-website-oauth-client-id.apps.googleusercontent.com
# GOOGLE_REVIEWS_CLIENT_SECRET=your-website-oauth-client-secret
# Must match Google Console exactly (localhost, not 127.0.0.1):
GOOGLE_REVIEWS_REDIRECT_URI=http://localhost:4321/api/google-reviews/callback
# Server-only storage for tokens + temporary review cache (gitignored)
GOOGLE_REVIEWS_DATA_DIR=.data/google-reviews
# Soft refresh TTL (seconds). Hard retention never exceeds 30 days (Google policy).
GOOGLE_REVIEWS_CACHE_TTL_SECONDS=21600
GOOGLE_REVIEWS_CACHE_MAX_AGE_SECONDS=2592000
GOOGLE_REVIEWS_DISPLAY_COUNT=3
# Local setup UI/API: enabled on loopback by default. Set false in production.
GOOGLE_REVIEWS_SETUP_ENABLED=true
# Optional production override for setup routes (header x-ggwc-setup-token or Bearer)
# GOOGLE_REVIEWS_SETUP_TOKEN=
# Optional cron/warm-cache secret for POST /api/google-reviews/refresh/
# GOOGLE_REVIEWS_CRON_SECRET=
